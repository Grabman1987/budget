# Local development settings. Copy to `.env` (git-ignored) only if you need to override a default;
# `npm run dev` works without it. Never put real secrets here, never commit `.env`.

# Public origin the browser uses. In `npm run dev` that is Vite (it proxies /api to the server).
# For `npm run build && npm start` (server serves the web app itself) use http://localhost:3000.
BUDGET_ORIGIN=http://localhost:5173

# WebAuthn relying party id, defaults to the host of BUDGET_ORIGIN.
# BUDGET_RP_ID=localhost

# One-time token for the first passkey. Unset in `npm run dev` = a random one is printed at start.
# BUDGET_SETUP_TOKEN=

# SQLite file. Default in dev: data/dev.sqlite, the file `npm run db:seed` fills with the synthetic ledger.
# DATABASE_PATH=data/dev.sqlite

# Port of the API server and where Vite proxies to.
# PORT=3000
# VITE_API_TARGET=http://localhost:3000

# Enables the read-only /api/debug/summary endpoint (behind the session). Never in production.
# BUDGET_DEBUG_API=1
