{
  "name": "budget",
  "version": "0.0.0",
  "private": true,
  "description": "Private household finance PWA",
  "type": "module",
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"npm run dev -w @budget/web\" \"npm run dev -w @budget/server\"",
    "build": "npm run build -w @budget/web && npm run build -w @budget/server",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "npm run build:e2e && playwright test",
    "proto": "node scripts/serve-static.mjs design/prototype 5180",
    "db:seed": "tsx scripts/db-seed.ts --fresh",
    "fixtures:ynab": "tsx scripts/ynab-export.ts",
    "fixtures:pp": "tsx scripts/pp-export.ts",
    "db:generate": "npm run generate -w @budget/db",
    "build:e2e": "npm run build -w @budget/web -- --mode e2e && npm run build -w @budget/server"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "~1.63.0",
    "@types/node": "^22.20.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
