+  setPayslipSourceConfig(opened.db, { salaryAccountId: accountId, automation: { payeeId }, wageTypes: {} }, ctx);
+  const originalId = createBooking(opened.db, { accountId, payeeId, date: linked ? '2026-09-30' : '2026-08-31',
+    amountCents: linked ? 297500 : 12345, status: 'confirmed', memo: 'Synthetic preserved payout',
