+        expectations,
+      });
+      if (!plan.eligible) return review(plan.reason);
+      if (existingSlot[0] && existingSlot[0].bookingId !== plan.bookingId) return review('payroll_already_exists');
+      const result = decidePayslipIntake(tx, id, {
+        action: 'confirm', accountId: target.id, payeeId: sender.id,
+        payoutDate: plan.payoutDate, bookingId: plan.bookingId,
+        expectedOccurrenceId: plan.expectedOccurrenceId,
+      }, { ...ctx, actor: `document-automation:payroll@${snapshot.configRevision ?? 'unversioned'}` }, existingSlot[0]?.id);
+      const captured = tx.select().from(payslip).where(eq(payslip.id, result.payslipId!)).get()!;
+      return {
+        status: plan.bookingId ? 'linked' : 'booked', reason: existingSlot[0] ? 'existing_payroll_source_attached' : 'unambiguous_source',
+        groupId: result.groupId ?? null, payslipId: result.payslipId!,
+        ...(captured.bookingId ? { bookingId: captured.bookingId } : {}),
+      };
+    });
+  } catch (error) {
+    if (error instanceof ConflictError || error instanceof BookingInvariantError || error instanceof EntityNotFoundError)
+      return review('current_state_needs_review');
+    throw error;
+  }
+}
