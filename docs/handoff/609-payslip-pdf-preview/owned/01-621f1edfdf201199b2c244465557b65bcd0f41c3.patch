diff --git a/apps/server/src/receipts/pdf-preview-thread.mjs b/apps/server/src/receipts/pdf-preview-thread.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..7d79b93ad60cc82f4bde4efa50e360d9a6ec47a9
--- /dev/null
+++ b/apps/server/src/receipts/pdf-preview-thread.mjs
@@ -0,0 +1,126 @@
+import { createHash } from 'node:crypto';
+import { dirname, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { parentPort, workerData } from 'node:worker_threads';
+
+// Per-surface and tracked live-pixel limits are not a native RSS or decoder-memory sandbox.
+const SIDE = 2048;
+const PIXELS = 4_194_304;
+const LIVE_PIXELS = 16_777_216;
+const OUTPUT = 8 * 1024 * 1024;
+class PreviewLimit extends Error {}
+class PreviewPage extends Error {}
+
+function boundedFactory(factory) {
+  if (!factory || !['create', 'reset', 'destroy'].every((key) => typeof factory[key] === 'function'))
+    throw new Error('renderer');
+  const create = factory.create.bind(factory);
+  const reset = factory.reset.bind(factory);
+  const destroy = factory.destroy.bind(factory);
+  const live = new Map();
+  let total = 0;
+  function size(width, height, previous = 0) {
+    if (!Number.isSafeInteger(width) || !Number.isSafeInteger(height) || width <= 0 || height <= 0 ||
+      width > SIDE || height > SIDE || width * height > PIXELS ||
+      total - previous + width * height > LIVE_PIXELS) throw new PreviewLimit();
+    return width * height;
+  }
+  // Wrap the public PDFDocumentProxy factory instance, not a private/non-exported class.
+  // PDF.js uses this same instance for output, masks, patterns and transparency surfaces.
+  factory.create = (width, height) => {
+    const pixels = size(width, height);
+    const entry = create(width, height);
+    live.set(entry.canvas, pixels);
+    total += pixels;
+    return entry;
+  };
+  factory.reset = (entry, width, height) => {
+    const previous = live.get(entry.canvas);
+    if (previous === undefined) throw new PreviewLimit();
+    const pixels = size(width, height, previous);
+    reset(entry, width, height);
+    live.set(entry.canvas, pixels);
+    total += pixels - previous;
+  };
+  factory.destroy = (entry) => {
+    const canvas = entry.canvas;
+    const pixels = live.get(canvas);
+    if (pixels === undefined) {
+      if (canvas?.width === 0 && canvas?.height === 0) return;
+      throw new PreviewLimit();
+    }
+    destroy(entry);
+    live.delete(canvas);
+    total -= pixels;
+  };
+  return () => {
+    for (const canvas of live.keys()) destroy({ canvas, context: null });
+    live.clear();
+    total = 0;
+  };
+}
+
+let task;
+let page;
+let release;
+try {
+  const { bytes, sha256, password, preset, page: number } = workerData;
+  if (!(bytes instanceof Uint8Array) || bytes.length > 15 * 1024 * 1024 ||
+    !/^[a-f0-9]{64}$/.test(sha256) || createHash('sha256').update(bytes).digest('hex') !== sha256 ||
+    !Number.isSafeInteger(number) || number < 1 || number > 30 ||
+    !['fit', 'detail'].includes(preset) || (password !== undefined &&
+      (typeof password !== 'string' || password.length > 1024))) throw new PreviewLimit();
+  const { getDocument, AnnotationMode } = await import('pdfjs-dist/legacy/build/pdf.mjs');
+  const root = dirname(fileURLToPath(import.meta.resolve('pdfjs-dist/package.json')));
+  task = getDocument({
+    data: bytes,
+    password,
+    isEvalSupported: false,
+    enableXfa: false,
+    enableHWA: false,
+    disableFontFace: true,
+    useSystemFonts: false,
+    useWorkerFetch: false,
+    isOffscreenCanvasSupported: false,
+    isImageDecoderSupported: false,
+    maxImageSize: PIXELS,
+    canvasMaxAreaInBytes: PIXELS * 4,
+    stopAtErrors: true,
+    standardFontDataUrl: resolve(root, 'standard_fonts') + sep,
+    cMapUrl: resolve(root, 'cmaps') + sep,
+    cMapPacked: true,
+    wasmUrl: resolve(root, 'wasm') + sep,
+    verbosity: 0,
+  });
+  const pdf = await task.promise;
+  if (!Number.isSafeInteger(pdf.numPages) || pdf.numPages > 30) throw new PreviewLimit();
+  if (number > pdf.numPages) throw new PreviewPage();
+  release = boundedFactory(pdf.canvasFactory);
+  page = await pdf.getPage(number);
+  if (!Number.isInteger(page.rotate) || page.rotate % 90 !== 0) throw new PreviewLimit();
+  const raw = page.getViewport({ scale: 1 });
+  if (!Number.isFinite(raw.width) || !Number.isFinite(raw.height) || raw.width <= 0 || raw.height <= 0)
+    throw new PreviewLimit();
+  const scale = Math.min((preset === 'detail' ? 1536 : 960) / raw.width, SIDE / raw.height);
+  const viewport = page.getViewport({ scale });
+  const width = Math.ceil(viewport.width), height = Math.ceil(viewport.height);
+  const entry = pdf.canvasFactory.create(width, height);
+  await page.render({
+    canvas: entry.canvas,
+    viewport,
+    annotationMode: AnnotationMode.DISABLE,
+    background: 'rgb(255,255,255)',
+  }).promise;
+  if (typeof entry.canvas.toBuffer !== 'function') throw new Error('renderer');
+  const png = entry.canvas.toBuffer('image/png');
+  if (!png.length || png.length > OUTPUT) throw new PreviewLimit();
+  const transfer = Uint8Array.from(png);
+  parentPort.postMessage({ png: transfer, page: number, pages: pdf.numPages, width, height }, [transfer.buffer]);
+} catch (error) {
+  parentPort.postMessage({ error: error?.name === 'PasswordException' ? 'password'
+    : error instanceof PreviewPage ? 'page' : error instanceof PreviewLimit ? 'limit' : 'unavailable' });
+} finally {
+  try { release?.(); } catch { /* No library diagnostics may leave this worker. */ }
+  try { page?.cleanup(); } catch { /* Parent owns final termination. */ }
+  try { await task?.destroy(); } catch { /* Parent owns final termination. */ }
+}
diff --git a/apps/server/src/receipts/pdf-preview.ts b/apps/server/src/receipts/pdf-preview.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3afa0588fefedc80f4583e80368ec44c78346e8d
--- /dev/null
+++ b/apps/server/src/receipts/pdf-preview.ts
@@ -0,0 +1,162 @@
+import { getReceipt, type Db } from '@budget/db';
+import { existsSync } from 'node:fs';
+import { open } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { Worker } from 'node:worker_threads';
+import { digest, receiptPath, RECEIPT_LIMIT } from './files';
+
+export type PdfPreviewCode =
+  | 'password'
+  | 'page'
+  | 'limit'
+  | 'busy'
+  | 'unavailable'
+  | 'source_changed'
+  | 'aborted';
+export type PdfPreviewInput = { page: number; preset: 'fit' | 'detail'; password?: string };
+export type PdfPreview = { png: Uint8Array; page: number; pages: number; width: number; height: number };
+export class PdfPreviewError extends Error {
+  constructor(readonly code: PdfPreviewCode) {
+    super('PDF preview unavailable');
+  }
+}
+
+const OUTPUT_LIMIT = 8 * 1024 * 1024;
+const TIME_LIMIT = 20_000;
+// Process-wide admission, acquired before file I/O. There is deliberately no waiting queue.
+let active = false;
+const aborted = (signal: AbortSignal) => {
+  if (signal.aborted) throw signal.reason instanceof PdfPreviewError
+    ? signal.reason : new PdfPreviewError('aborted');
+};
+
+/** Read at most the recorded size + one byte, then verify THAT buffer, not an earlier file. */
+async function sourceBytes(dir: string, sha256: string, size: number, signal: AbortSignal) {
+  if (!Number.isSafeInteger(size) || size <= 0 || size > RECEIPT_LIMIT)
+    throw new PdfPreviewError('limit');
+  const file = await open(receiptPath(dir, sha256), 'r');
+  let bytes: Buffer | undefined;
+  try {
+    aborted(signal);
+    const metadata = await file.stat();
+    aborted(signal);
+    if (!metadata.isFile() || metadata.size !== size) throw new PdfPreviewError('unavailable');
+    bytes = Buffer.alloc(size + 1);
+    let used = 0;
+    while (used < bytes.length) {
+      aborted(signal);
+      const read = await file.read(bytes, used, bytes.length - used, used);
+      if (!read.bytesRead) break;
+      used += read.bytesRead;
+    }
+    aborted(signal);
+    if (used !== size || digest(bytes.subarray(0, used)) !== sha256)
+      throw new PdfPreviewError('unavailable');
+    return bytes.subarray(0, used);
+  } catch (error) {
+    bytes?.fill(0);
+    throw error;
+  } finally {
+    await file.close();
+  }
+}
+
+function render(bytes: Uint8Array, sha256: string, input: PdfPreviewInput, signal: AbortSignal) {
+  aborted(signal);
+  const built = resolve(import.meta.dirname, 'pdf-preview-thread.js');
+  const worker = new Worker(
+    existsSync(built) ? built : resolve(import.meta.dirname, 'pdf-preview-thread.mjs'),
+    {
+      workerData: { bytes, sha256, ...input },
+      resourceLimits: { maxOldGenerationSizeMb: 128 },
+      stdout: true,
+      stderr: true,
+    },
+  );
+  // PDF/native diagnostics can contain private document data. Never forward them.
+  worker.stdout?.resume();
+  worker.stderr?.resume();
+  return new Promise<PdfPreview>((done, fail) => {
+    let finishing = false;
+    const finish = (result: PdfPreview | PdfPreviewError) => {
+      if (finishing) return;
+      finishing = true;
+      signal.removeEventListener('abort', cancel);
+      // Capacity stays held until the actual worker has exited, including timeout/abort paths.
+      void worker.terminate().then(
+        () => result instanceof PdfPreviewError ? fail(result) : done(result),
+        () => {
+          // A failed termination request must not release admission while a worker is alive.
+          if (worker.threadId === -1) fail(new PdfPreviewError('unavailable'));
+          else worker.once('exit', () => fail(new PdfPreviewError('unavailable')));
+        },
+      );
+    };
+    const cancel = () => finish(signal.reason instanceof PdfPreviewError
+      ? signal.reason : new PdfPreviewError('aborted'));
+    worker.once('message', (message: unknown) => {
+      if (!message || typeof message !== 'object') return finish(new PdfPreviewError('unavailable'));
+      const data = message as Record<string, unknown>;
+      if (['password', 'page', 'limit', 'unavailable'].includes(String(data['error'])))
+        return finish(new PdfPreviewError(data['error'] as PdfPreviewCode));
+      const { png, page, pages, width, height } = data;
+      if (
+        !(png instanceof Uint8Array) || !png.length || png.length > OUTPUT_LIMIT ||
+        page !== input.page || !Number.isInteger(pages) || Number(pages) < input.page || Number(pages) > 30 ||
+        !Number.isInteger(width) || !Number.isInteger(height) ||
+        Number(width) <= 0 || Number(height) <= 0 || Number(width) > 2048 || Number(height) > 2048 ||
+        png.length < 24 || Buffer.from(png.subarray(0, 8)).toString('hex') !== '89504e470d0a1a0a' ||
+        Buffer.from(png.subarray(16, 24)).readUInt32BE(0) !== width ||
+        Buffer.from(png.subarray(16, 24)).readUInt32BE(4) !== height
+      ) return finish(new PdfPreviewError('unavailable'));
+      finish({ png, page: Number(page), pages: Number(pages), width: Number(width), height: Number(height) });
+    });
+    worker.once('error', () => finish(new PdfPreviewError('unavailable')));
+    worker.once('exit', () => finish(new PdfPreviewError('unavailable')));
+    signal.addEventListener('abort', cancel, { once: true });
+    if (signal.aborted) cancel();
+  });
+}
+
+/** Read-only inert pixels; no extraction, password retention, receipt mutation or audit write. */
+export async function receiptPdfPreview(
+  db: Db,
+  dir: string,
+  id: string,
+  input: PdfPreviewInput,
+  signal: AbortSignal,
+): Promise<PdfPreview> {
+  aborted(signal);
+  if (active) throw new PdfPreviewError('busy');
+  active = true;
+  const deadline = new AbortController();
+  const timer = setTimeout(() => deadline.abort(new PdfPreviewError('limit')), TIME_LIMIT);
+  const requestSignal = AbortSignal.any([signal, deadline.signal]);
+  let bytes: Buffer | undefined;
+  try {
+    const source = getReceipt(db, id);
+    if (source.mime !== 'application/pdf') throw new PdfPreviewError('unavailable');
+    try {
+      bytes = await sourceBytes(dir, source.sha256!, source.sizeBytes, requestSignal);
+    } catch (error) {
+      throw error instanceof PdfPreviewError ? error : new PdfPreviewError('unavailable');
+    }
+    const result = await render(bytes, source.sha256!, input, requestSignal);
+    aborted(requestSignal);
+    // Rendering awaited I/O: never publish a source removed or replaced in the meantime.
+    try {
+      const live = getReceipt(db, id);
+      if (live.sha256 !== source.sha256 || live.sizeBytes !== source.sizeBytes || live.mime !== source.mime)
+        throw new PdfPreviewError('source_changed');
+    } catch {
+      result.png.fill(0);
+      throw new PdfPreviewError('source_changed');
+    }
+    return result;
+  } finally {
+    clearTimeout(timer);
+    bytes?.fill(0);
+    // A pending bounded filesystem operation also completes/closes before this slot is freed.
+    active = false;
+  }
+}
