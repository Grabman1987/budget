new file mode 100644
index 0000000000000000000000000000000000000000..685a488f667f89d52e5344877b929f2d98c3f417
--- /dev/null
+++ b/packages/db/src/repos/month-close-state.ts
@@ -0,0 +1,48 @@
+import { addMonths, lastDayOfMonth } from '@budget/domain';
+import { createHash } from 'node:crypto';
+import { sql } from 'drizzle-orm';
+import type { Executor } from './types';
+
+/**
+ * An aggregate of retained booking/split and relevant planning/account audits supplies an ABA fence. Before and
+ * after dates include moves out of the month; Undo is another retained event. Only a count
+ * leaves SQLite, never private audit snapshots. This does not create a close task or a lock.
+ */
+export function monthCloseSourceRevision(db: Executor, month: string, facts: unknown,
+  accountIds: readonly string[] = [],
+): string {
+  const nextMonth = addMonths(month, 1);
+  const accountList = JSON.stringify([...new Set(accountIds)].sort());
+  const end = lastDayOfMonth(month);
+  const rows = db.all<{ count: number }>(sql`
+    SELECT COUNT(*) AS count FROM audit_log a WHERE
+      (a.entity_type = 'booking' AND
+        (substr(json_extract(a.before_json, '$.date'), 1, 7) = ${month}
+         OR substr(json_extract(a.after_json, '$.date'), 1, 7) = ${month}))
+      OR (a.entity_type IN ('envelope_month', 'budget_month') AND
+        (json_extract(a.before_json, '$.month') <= ${nextMonth}
+         OR json_extract(a.after_json, '$.month') <= ${nextMonth}))
+      OR (a.entity_type = 'account' AND a.entity_id IN (SELECT value FROM json_each(${accountList})))
+      OR (a.entity_type = 'account_reconciliation' AND
+        (json_extract(a.before_json, '$.account_id') IN (SELECT value FROM json_each(${accountList}))
+         OR json_extract(a.after_json, '$.account_id') IN (SELECT value FROM json_each(${accountList}))))
+      OR (a.entity_type = 'valuation' AND
+        ((json_extract(a.before_json, '$.account_id') IN (SELECT value FROM json_each(${accountList}))
+          AND json_extract(a.before_json, '$.date') <= ${end})
+         OR (json_extract(a.after_json, '$.account_id') IN (SELECT value FROM json_each(${accountList}))
+          AND json_extract(a.after_json, '$.date') <= ${end})))
+      OR (a.entity_type = 'booking_split' AND (
+        EXISTS (SELECT 1 FROM booking b WHERE b.id IN
+          (json_extract(a.before_json, '$.booking_id'), json_extract(a.after_json, '$.booking_id'))
+          AND substr(b.date, 1, 7) = ${month})
+        OR EXISTS (SELECT 1 FROM audit_log parent WHERE parent.entity_type = 'booking'
+          AND parent.entity_id IN
+            (json_extract(a.before_json, '$.booking_id'), json_extract(a.after_json, '$.booking_id'))
+          AND (substr(json_extract(parent.before_json, '$.date'), 1, 7) = ${month}
+            OR substr(json_extract(parent.after_json, '$.date'), 1, 7) = ${month}))
+      ))
+  `);
+  const eventCount = rows[0]?.count;
+  if (!Number.isSafeInteger(eventCount) || eventCount! < 0) throw new RangeError('Invalid month audit count');
+  return createHash('sha256').update(JSON.stringify({ version: 1, month, eventCount, facts })).digest('hex');
+}
