+/** Only an unclaimed target or one last written with this goal may be synchronized. */
+function synchronizeGoalTarget(db: Executor, goal: Goal, validFrom: string, ctx: AuditContext): void {
+  if (!goal.categoryId || !goal.targetDate || goal.manualCompletedOn !== null) return;
+  const peers = db.select().from(savingsGoal).where(isNull(savingsGoal.deletedAt)).all();
+  if (peers.some((other) => other.id !== goal.id && other.categoryId === goal.categoryId && other.manualCompletedOn === null)) return;
+  const effectiveFrom = validFrom < (goal.startMonth ?? goal.createdAt.slice(0, 7))
+    ? (goal.startMonth ?? goal.createdAt.slice(0, 7)) : validFrom;
+  const versions = db.select().from(categoryTarget).where(eq(categoryTarget.categoryId, goal.categoryId)).all();
+  const effective = versions.filter((v) => v.deletedAt === null && v.validFrom <= effectiveFrom)
+    .sort((a, b) => b.validFrom.localeCompare(a.validFrom))[0];
+  const overwritten = versions.find((v) => v.validFrom === effectiveFrom) ?? effective;
+  if (overwritten) {
+    if (overwritten.deletedAt === null && overwritten.kind === 'by_date' && overwritten.amountCents === goal.targetCents && overwritten.targetDate === goal.targetDate) return;
+    const last = db.get<{ groupId: string | null }>(sql`SELECT group_id AS groupId FROM audit_log
+      WHERE entity_type='category_target' AND entity_id=${overwritten.id} ORDER BY rowid DESC LIMIT 1`);
+    const owner = last?.groupId ? db.get<{ n: number }>(sql`SELECT count(*) AS n FROM audit_log
+      WHERE group_id=${last.groupId} AND entity_type='savings_goal' AND entity_id=${goal.id}`)?.n : 0;
+    if (!owner) return;
