+export function fundGoalRate(db: Executor, id: string, month: string, ctx: AuditContext): { groupId: string; changedCount: number; assignedCents: number } {
+  const grouped = withGroup(ctx);
+  return runInTransaction(db, (tx) => {
+    const goal = getGoal(tx, id, month);
+    if (goal.deletedAt !== null || !goal.categoryId || goal.lifecycle.state === 'completed' || !goal.funding || goal.funding.conflict)
+      throw new CategoryRuleError(goal.funding?.conflict ?? 'Für dieses Sparziel ist keine Rate zuzuweisen.');
+    const amount = goal.funding.remainingCents;
+    if (amount === 0) return { groupId: grouped.groupId, changedCount: 0, assignedCents: 0 };
+    const assigned = budget(tx, [month])[0]?.envelopes[goal.categoryId]?.assignedCents ?? 0;
+    assignMany(tx, month, [{ categoryId: goal.categoryId, assignedCents: assigned + amount }], grouped);
