+      : `?vorlage=${view}&zeitraum=${view === 'year' ? 'YTD' : view === 'total' ? '3J' : '1J'}${view === 'category' ? '&kategorien=%5B%22c09%22%5D' : ''}`;
+  await page.goto(`/reports/explorer${search}`);
+  const table =
