@@ -0,0 +1,178 @@
+// @vitest-environment jsdom
+import { DEFAULT_EXPLORER_QUERY, type ExplorerResult } from '@budget/domain';
+import { setAmountsHidden } from '@budget/ui';
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { ExplorerChart626 } from './explorer-chart-626';
+import { customChartModel } from './explorer-chart-model-626';
+const width = vi.hoisted(() => ({ value: 320 }));
+vi.mock('../charts/use-element-width', () => ({ useElementWidth: () => [vi.fn(), width.value] }));
+afterEach(() => {
+  cleanup();
+  width.value = 320;
+  setAmountsHidden(false);
+});
+function source(values: number[]): ExplorerResult {
+  return {
+    query: { ...DEFAULT_EXPLORER_QUERY, cols: 'monat' },
+    months: ['2024-01', '2024-02', '2024-04'].slice(0, values.length),
+    columns: ['2024-01', '2024-02', '2024-04']
+      .slice(0, values.length)
+      .map((key) => ({ key, months: [key] })),
+    unit: 'cents',
+    rows: [{ key: 'source', label: 'Originalquelle', class: null, values, total: 7777 }],
+    totals: null,
+    truncated: 0,
+    good: 'low',
+  };
+}
+function finiteGeometry(container: HTMLElement, actualWidth: number) {
+  const paths = container.querySelectorAll('.ex-chart-series .l-actual');
+  for (const path of paths) {
+    const value = path.getAttribute('d') ?? '';
+    expect(value).not.toMatch(/NaN|Infinity|undefined/);
+    const numbers = value.match(/-?\d+(?:\.\d+)?(?:e[+-]?\d+)?/gi)?.map(Number) ?? [];
+    expect(numbers.every(Number.isFinite)).toBe(true);
+    numbers.forEach((value, index) => {
+      expect(value).toBeGreaterThanOrEqual(index % 2 === 0 ? 60 : 16);
+      expect(value).toBeLessThanOrEqual(index % 2 === 0 ? actualWidth - 12 : 192);
+    });
+  }
+}
+describe('626 actual-width original-value line geometry', () => {
+  it.each([320, 1200])(
+    'has finite bounded zero/signed/single/extreme geometry at %i CSS pixels',
+    (actualWidth) => {
+      width.value = actualWidth;
+      for (const values of [
+        [0, 0, 0],
+        [-1001, -2001, -1],
+        [1001],
+        [Number.MAX_SAFE_INTEGER, -Number.MAX_SAFE_INTEGER, 0],
+      ]) {
+        const mounted = render(<ExplorerChart626 data={customChartModel(source(values))} />);
+        expect(mounted.container.querySelector('svg.chart')?.getAttribute('width')).toBe(
+          String(actualWidth),
+        );
+        finiteGeometry(mounted.container, actualWidth);
+        mounted.unmount();
+      }
+    },
+  );
+  it('shows empty/missing values honestly and breaks both line segments at an explicit null', () => {
+    const empty = render(<ExplorerChart626 data={customChartModel(source([]))} />);
+    expect(screen.getByRole('status').textContent).toContain('Keine Werte');
+    empty.unmount();
+    const model = customChartModel(source([1001, 0, -1001]));
+    model.rows[0]!.values = [1001, null, -1001];
+    const mounted = render(<ExplorerChart626 data={model} />);
+    expect(mounted.container.querySelectorAll('.ex-chart-series .l-actual')).toHaveLength(2);
+    finiteGeometry(mounted.container, 320);
+    mounted.unmount();
+    const absent = customChartModel(source([0, 0, 0]));
+    absent.rows[0]!.values = [null, null, null];
+    const missing = render(<ExplorerChart626 data={absent} />);
+    expect(missing.container.querySelectorAll('.ex-chart-series .l-actual')).toHaveLength(0);
+    expect(screen.getByRole('status').textContent).toContain('Lücken');
+  });
+  it('paints an isolated interior value even when axis-label cadence skips its column', () => {
+    const model = customChartModel(source([0, 0, 0]));
+    model.columns = Array.from({ length: 12 }, (_, index) => ({
+      key: `2024-${String(index + 1).padStart(2, '0')}`,
+      label: `Monat ${index + 1}`,
+      months: [`2024-${String(index + 1).padStart(2, '0')}`],
+    }));
+    model.rows[0]!.values = [null, 100, null, null, null, null, null, null, null, null, null, null];
+    const mounted = render(<ExplorerChart626 data={model} />);
+    const series = mounted.container.querySelector('.ex-chart-series')!;
+    expect(series.querySelectorAll('.l-actual')).toHaveLength(1);
+    expect(series.querySelector('[data-chart-point="1"] .ex-series-marker')).not.toBeNull();
+    expect(series.querySelectorAll('.ex-series-marker')).toHaveLength(1);
+    expect(series.querySelector('[data-chart-point="0"]')).toBeNull();
+    expect(series.querySelector('[data-chart-point="2"]')).toBeNull();
+    finiteGeometry(mounted.container, 320);
+  });
+
+  it('uses actual irregular month distances rather than equal spacing or invented dates', () => {
+    const mounted = render(<ExplorerChart626 data={customChartModel(source([100, 200, 300]))} />);
+    const path =
+      mounted.container.querySelector('.ex-chart-series .l-actual')?.getAttribute('d') ?? '';
+    const numbers = path.match(/-?\d+(?:\.\d+)?/g)!.map(Number);
+    expect(numbers[0]).toBe(60);
+    expect(numbers[2]).toBeCloseTo(144.484, 3);
+    expect(numbers[4]).toBe(308);
+  });
+  it('keeps eight distinct named marker patterns and literal Further values without changing source totals', async () => {
+    const data = source([10, 20, 30]);
+    data.rows = Array.from({ length: 8 }, (_, index) => ({
+      key: `first-${index}`,
+      label: `Quelle ${index + 1}`,
+      class: null,
+      values: [10, 20, 30],
+      total: 9001,
+    }));
+    data.rows.push(
+      { key: 'ninth', label: 'Neunte', class: null, values: [901, -101, 0], total: 9002 },
+      { key: 'tenth', label: 'Zehnte', class: null, values: [-401, 201, 0], total: 9003 },
+    );
+    const before = structuredClone(data);
+    const mounted = render(<ExplorerChart626 data={customChartModel(data)} />);
+    expect(screen.getByRole('list', { name: 'Reihenlegende' }).querySelectorAll('li')).toHaveLength(
+      9,
+    );
+    const marks = [
+      ...screen.getByRole('list', { name: 'Reihenlegende' }).querySelectorAll('.ex-series-marker'),
+    ].map((node) => node.getAttribute('d'));
+    expect(new Set(marks).size).toBe(9);
+    const target = mounted.container.querySelector('.chart-interactive')!;
+    fireEvent.keyDown(target, { key: 'ArrowRight' });
+    await waitFor(() =>
+      expect(document.querySelector('.chart-tooltip')?.textContent).toContain(
+        'Weitere · Zeilensumme (2)',
+      ),
+    );
+    expect(document.querySelector('.chart-tooltip')?.textContent).toContain('5,00 €');
+    expect(data).toEqual(before);
+  });
+  it('distinguishes an original source named Weitere from the real remaining-row aggregate', async () => {
+    const data = source([10, 20, 30]);
+    data.rows = Array.from({ length: 8 }, (_, index) => ({
+      key: `source-${index}`,
+      label: index === 0 ? 'Weitere' : `Quelle ${index + 1}`,
+      class: null,
+      values: [1234, 0, 0],
+      total: 1234,
+    }));
+    data.rows.push(
+      { key: 'ninth', label: 'Neunte', class: null, values: [901, -101, 0], total: 800 },
+      { key: 'tenth', label: 'Zehnte', class: null, values: [-401, 201, 0], total: -200 },
+    );
+    const mounted = render(<ExplorerChart626 data={customChartModel(data)} />);
+    fireEvent.keyDown(mounted.container.querySelector('.chart-interactive')!, {
+      key: 'ArrowRight',
+    });
+    await waitFor(() => expect(document.querySelector('.chart-tooltip')).not.toBeNull());
+    const names = [...document.querySelectorAll('.chart-tooltip-row > span')].map(
+      (node) => node.textContent,
+    );
+    expect(names.filter((name) => name === 'Weitere')).toHaveLength(1);
+    expect(names.filter((name) => name === 'Weitere · Zeilensumme (2)')).toHaveLength(1);
+    expect(names).not.toContain('Weitere · Zeilensumme (1)');
+    expect(document.querySelector('.chart-tooltip')?.textContent).toContain('12,34 €');
+    expect(document.querySelector('.chart-tooltip')?.textContent).toContain('5,00 €');
+  });
+
+  it('keeps amount privacy on tooltip/data alternatives without changing exact source values', async () => {
+    const data = source([1234]);
+    const mounted = render(<ExplorerChart626 data={customChartModel(data)} />);
+    await act(async () => {
+      setAmountsHidden(true);
+    });
+    fireEvent.keyDown(mounted.container.querySelector('.chart-interactive')!, {
+      key: 'ArrowRight',
+    });
+    await waitFor(() => expect(document.querySelector('.chart-tooltip')).not.toBeNull());
+    expect(document.querySelector('.chart-tooltip')?.textContent).not.toContain('12,34');
+    expect(data.rows[0]?.values).toEqual([1234]);
+  });
+});
diff --git a/apps/web/src/reports/explorer-chart-626.tsx b/apps/web/src/reports/explorer-chart-626.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4dffb035a484e781f49d8a37cd0abaf75f6f02e9
--- /dev/null
+++ b/apps/web/src/reports/explorer-chart-626.tsx
@@ -0,0 +1,294 @@
+import {
+  AxisLine,
+  Button,
+  ChartSvg,
+  Graticule,
+  Line,
+  ReportTrendContext,
+  XTicks,
+  useAmountPrivacy,
+} from '@budget/ui';
+import { useState } from 'react';
+import { useElementWidth } from '../charts/use-element-width';
+import { kfmt } from '../wealth/networth-model';
+import {
+  boundedChartRows,
+  type ExplorerChartModel,
+  type ExplorerChartUnit,
+} from './explorer-chart-model-626';
+import { explorerChartValue626 } from './explorer-table-inspector-626';
+
+export function ExplorerViewToggle626({
+  value,
+  onChange,
+  busy = false,
+}: {
+  value: 'table' | 'chart';
+  onChange: (value: 'table' | 'chart') => void;
+  busy?: boolean;
+}) {
+  return (
+    <div className="ex-view-toggle" role="group" aria-label="Darstellung">
+      <Button variant="ghost" aria-pressed={value === 'table'} onClick={() => onChange('table')}>
+        Tabelle
+      </Button>
+      <Button
+        variant="ghost"
+        aria-pressed={value === 'chart'}
+        disabled={busy}
+        onClick={() => onChange('chart')}
+      >
+        Diagramm
+      </Button>
+    </div>
+  );
+}
+
+// Distinct labelled marker shapes retain row identity without treating dashes as forecasts.
+function marker(index: number, x: number, y: number) {
+  const shapes = [
+    `M${x - 3},${y}a3,3 0 1,0 6,0a3,3 0 1,0 -6,0`,
+    `M${x - 3},${y - 3}h6v6h-6Z`,
+    `M${x},${y - 4}l4,7h-8Z`,
+    `M${x},${y - 4}l4,4l-4,4l-4,-4Z`,
+    `M${x - 3},${y - 3}l6,6M${x + 3},${y - 3}l-6,6`,
+    `M${x - 4},${y}h8M${x},${y - 4}v8`,
+    `M${x - 4},${y}l2,-3h4l2,3l-2,3h-4Z`,
+    `M${x - 4},${y - 3}h8l-4,7Z`,
+    `M${x - 4},${y}a4,4 0 1,0 8,0a4,4 0 1,0 -8,0M${x - 1},${y}h2`,
+  ];
+  return <path d={shapes[index]!} className="ex-series-marker" />;
+}
+const unitLabel = (unit: ExplorerChartUnit) =>
+  unit === 'cents' ? 'Euro' : unit === 'bp' ? 'Prozent' : 'Anzahl';
+
+export function ExplorerChart626({ data }: { data: ExplorerChartModel }) {
+  useAmountPrivacy();
+  const [selected, setSelected] = useState('');
+  const [ref, width] = useElementWidth<HTMLDivElement>();
+  const cohort = data.cohorts.find((value) => value.id === selected) ?? data.cohorts[0];
+  const series = cohort ? boundedChartRows(cohort.rows, cohort.unit) : [];
+  const unit = cohort?.unit ?? 'cents';
+  const present = series.flatMap((row) =>
+    row.values.filter((value): value is number => value !== null),
+  );
+  const low = Math.min(0, ...present);
+  const high = Math.max(1, ...present);
+  const plotWidth = Math.max(1, width - 72);
+  const dates = data.columns.map((column) => {
+    const month = column.months[0];
+    return month && /^\d{4}-\d{2}$/.test(month) ? Date.parse(`${month}-01T00:00:00Z`) : NaN;
+  });
+  const timed =
+    data.temporal && dates.length > 1 && dates.every(Number.isFinite) && dates.at(-1)! > dates[0]!;
+  const x = (index: number) =>
+    60 +
+    (timed
+      ? (dates[index]! - dates[0]!) / (dates.at(-1)! - dates[0]!)
+      : data.columns.length > 1
+        ? index / (data.columns.length - 1)
+        : 0.5) *
+      plotWidth;
+  const y = (value: number) => 192 - ((value - low) / (high - low)) * 176;
+  const cadence = Math.max(
+    1,
+    Math.ceil(data.columns.length / Math.max(1, Math.floor(plotWidth / 76))),
+  );
+  const points = data.columns.map((column, index) => ({
+    x: x(index),
+    date: column.label,
+    series: [
+      ...series.map((row) => ({
+        name:
+          row.key === 'remaining' ? `Weitere · Zeilensumme (${row.sourceRows.length})` : row.label,
+        value: explorerChartValue626(row.values[index] ?? null, unit),
+      })),
+      ...(data.averageReference !== null
+        ? [{ name: 'Ø je Monat', value: explorerChartValue626(data.averageReference, unit) }]
+        : []),
+    ],
+  }));
+  const remaining = series.find((row) => row.key === 'remaining');
+  return (
+    <section className="ex-chart-626" aria-label="Diagrammansicht">
+      {data.cohorts.length > 1 && (
+        <label className="ex-chart-cohort">
+          Diagrammzeilen
+          <select value={cohort?.id ?? ''} onChange={(event) => setSelected(event.target.value)}>
+            {data.cohorts.map((value) => (
+              <option key={value.id} value={value.id}>
+                {value.label}
+              </option>
+            ))}
+          </select>
+        </label>
+      )}
+      <p className="ov-note">
+        {cohort?.label ?? 'Zeilen'} · {unitLabel(unit)} ·{' '}
+        {data.temporal ? 'Zeitspalten der Tabelle' : 'Spalte der Tabelle'}.
+      </p>
+      <div ref={ref} className="ex-chart-drawing">
+        {!series.length || !data.columns.length ? (
+          <p role="status">Keine Werte für diese Auswahl.</p>
+        ) : (
+          width > 72 && (
+            <ReportTrendContext.Provider value={false}>
+              <ChartSvg
+                width={width}
+                height={228}
+                label={`Diagramm · ${cohort?.label ?? 'Zeilen'} · ${unitLabel(unit)}`}
+                points={points}
+                table
+              >
+                <Graticule
+                  x1={60}
+                  x2={width - 12}
+                  lines={Array.from({ length: 5 }, (_, index) => {
+                    const value = Math.round(low + ((high - low) * index) / 4);
+                    return { y: y(value), label: kfmt(unit === 'count' ? value : value / 100) };
+                  })}
+                />
+                <AxisLine x1={60} x2={width - 12} y={y(0)} />
+                {series.map((row, rowIndex) => {
+                  const segments: Array<Array<[number, number]>> = [];
+                  let segment: Array<[number, number]> = [];
+                  row.values.forEach((value, index) => {
+                    if (value === null) {
+                      if (segment.length) segments.push(segment);
+                      segment = [];
+                    } else segment.push([x(index), y(value)]);
+                  });
+                  if (segment.length) segments.push(segment);
+                  return (
+                    <g
+                      key={row.key}
+                      data-series-key={row.key}
+                      className={`ex-chart-series ex-chart-series-${rowIndex}`}
+                    >
+                      {segments.map((segment, index) => (
+                        <Line key={index} points={segment} kind="actual" draw={false} />
+                      ))}
+                      {row.values.map((value, index) =>
+                        value !== null &&
+                        (index % cadence === 0 ||
+                          index === row.values.length - 1 ||
+                          (row.values[index - 1] == null && row.values[index + 1] == null)) ? (
+                          <g key={index} data-chart-point={index}>
+                            {marker(rowIndex, x(index), y(value))}
+                          </g>
+                        ) : null,
+                      )}
+                    </g>
+                  );
+                })}
+                {data.averageReference !== null && (
+                  <Line
+                    points={[
+                      [60, y(data.averageReference)],
+                      [width - 12, y(data.averageReference)],
+                    ]}
+                    kind="benchmark"
+                    draw={false}
+                  />
+                )}
+                <XTicks
+                  y={216}
+                  ticks={data.columns.flatMap((column, index) =>
+                    index % cadence === 0 ? [{ x: x(index), label: column.label }] : [],
+                  )}
+                />
+              </ChartSvg>
+            </ReportTrendContext.Provider>
+          )
+        )}
+      </div>
+      {series.length > 0 && (
+        <ul className="ex-chart-legend" aria-label="Reihenlegende">
+          {series.map((row, index) => (
+            <li key={row.key}>
+              <svg width="24" height="16" viewBox="0 0 24 16" aria-hidden="true">
+                <path d="M0,8H24" className="ex-series-rule" />
+                {marker(index, 12, 8)}
+              </svg>
+              <span>
+                {row.label}
+                {row.key === 'remaining' ? ` (${row.sourceRows.length} Zeilen)` : ''}
+              </span>
+            </li>
+          ))}
+        </ul>
+      )}
+      {data.averageReference !== null && (
+        <p className="ov-note">
+          Strichpunktiert: Ø je Monat {explorerChartValue626(data.averageReference, unit)}.
+        </p>
+      )}
+      {present.length === 0 && series.length > 0 && data.columns.length > 0 && (
+        <p role="status">Fehlende Werte bleiben Lücken, nicht null Euro.</p>
+      )}
+      {remaining && (
+        <>
+          <p className="ov-note">
+            Weitere ist die Zeilensumme der übrigen {remaining.sourceRows.length} angezeigten Zeilen
+            je Spalte. Fehlende oder nicht darstellbare Summen bleiben offen.{' '}
+            {data.measure === 'avg'
+              ? 'Durchschnittswerte werden hier nur als angezeigte Zellen addiert, nicht neu gemittelt.'
+              : data.measure === 'anzahl'
+                ? 'Buchungszahlen können sich bei geteilten Buchungen überschneiden; dies ist keine Gesamtzahl unterschiedlicher Buchungen.'
+                : ''}
+            {unit === 'bp' ? ' Prozentwerte werden nicht addiert.' : ''}
+          </p>
+          <details className="ex-chart-originals">
+            <summary>Weitere: ursprüngliche Zeilen und eigene Summen</summary>
+            <div className="ex-chart-original-scroll">
+              <table>
+                <caption>Originalwerte der übrigen angezeigten Zeilen</caption>
+                <thead>
+                  <tr>
+                    <th scope="col">Zeile</th>
+                    {data.columns.map((column) => (
+                      <th key={column.key} scope="col">
+                        {column.label}
+                      </th>
+                    ))}
+                    {data.summaryColumns.map((column) => (
+                      <th key={column.key} scope="col">
+                        {column.label}
+                      </th>
+                    ))}
+                  </tr>
+                </thead>
+                <tbody>
+                  {remaining.sourceRows.map((row) => (
+                    <tr key={row.key}>
+                      <th scope="row">{row.label}</th>
+                      {row.values.map((value, index) => (
+                        <td key={data.columns[index]?.key ?? index}>
+                          {explorerChartValue626(value, unit)}
+                        </td>
+                      ))}
+                      {data.summaryColumns.map((column) => (
+                        <td key={column.key}>{explorerChartValue626(row[column.key], unit)}</td>
+                      ))}
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          </details>
+        </>
+      )}
+      {data.truncated > 0 && (
+        <p className="ov-note">
+          Das Diagramm umfasst nur die {data.rows.length} angezeigten Zeilen; {data.truncated}{' '}
+          weitere Zeilen sind nicht enthalten.
+        </p>
+      )}
+      <p className="ov-note">
+        Linien verbinden vorhandene Tabellenwerte; Lücken werden nicht überbrückt. Reihen bleiben
+        durch Namen und unterschiedliche Zeichen erkennbar. Die ursprünglichen Summen und Buchungen
+        bleiben in der Tabelle verfügbar.
+      </p>
+    </section>
+  );
+}
