+    if (path.startsWith('/api/') && !['GET', 'HEAD', 'OPTIONS'].includes(request.method()))
+      writes.push(`${request.method()} ${path}`);
+  });
+  await page.addInitScript(() => localStorage.setItem('budget-theme', 'light'));
+  const search =
+    view === 'custom'
