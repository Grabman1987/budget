+
+
+/* Calendar-year scenario: existing monthly values and local event selection. */
+.year-scenario-lead {
+  margin: 0;
+  padding: 8px 24px;
+}
+.year-scenario-lead dt {
+  color: var(--ink-2);
+}
+.year-scenario-lead dd {
+  margin: 8px 0;
+  font-size: var(--fs-display);
+  font-weight: 640;
+  font-variant-numeric: tabular-nums;
+  overflow-wrap: anywhere;
+}
+.year-scenario-context {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 8px 24px;
+  padding: 0 24px 16px;
+  color: var(--ink-2);
+}
+.year-scenario-context strong {
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+}
+.year-scenario-context small {
+  flex-basis: 100%;
+}
+.year-scenario-chart {
+  padding: 0 24px;
+  min-width: 0;
+}
+.year-chart-low {
+  color: var(--ink-2);
+  margin-block: 8px 16px;
+  font-size: var(--fs-meta);
+}
+.year-events,
+.year-instructions {
+  border-top: 1px solid var(--rule);
+}
+.year-events > summary,
+.year-instructions > summary {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 44px;
+  padding: 8px 24px;
+  cursor: pointer;
+}
+.year-events > summary:focus-visible,
+.year-instructions > summary:focus-visible {
+  outline: 2px solid var(--line);
+  outline-offset: -2px;
+}
+.year-events > summary svg,
+.year-instructions > summary svg {
+  flex-shrink: 0;
+}
+.year-events[open] > summary svg {
+  transform: rotate(180deg);
+}
+.year-event-list {
+  padding: 0;
+  margin: 0 24px 16px;
+  list-style: none;
+}
+.year-event-list > li {
+  display: grid;
+  grid-template-columns: minmax(9ch, auto) minmax(0, 1fr) auto auto;
+  align-items: center;
+  gap: 12px;
+  padding-block: 8px;
+  border-top: 1px solid var(--rule);
+}
+.year-event-list small {
+  display: block;
+  color: var(--ink-2);
+  overflow-wrap: anywhere;
+}
+.year-event-list .btn {
+  min-height: 44px;
+}
+.year-event-amount {
+  font-variant-numeric: tabular-nums;
+  overflow-wrap: anywhere;
+}
+@media (max-width: 767px) {
+  .year-scenario-lead,
+  .year-scenario-chart {
+    padding-inline: 16px;
+  }
+  .year-scenario-context {
+    padding-inline: 16px;
+  }
+  .year-events > summary,
+  .year-instructions > summary {
+    padding-inline: 16px;
+  }
+  .year-event-list {
+    margin-inline: 16px;
+  }
+  .year-event-list > li {
+    grid-template-columns: minmax(0, 1fr) auto;
+  }
+  .year-event-date,
+  .year-event-list > li > div:nth-child(2) {
+    grid-column: 1 / -1;
+  }
+}
+
+.year-planning .scenario-label .btn {
+  min-width: 44px;
+  min-height: 44px;
+}
