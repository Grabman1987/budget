+import { expect, test, type Page } from '@playwright/test';
+import { readFileSync } from 'node:fs';
+import ts from 'typescript';
+import type * as Store from '../apps/web/src/pwa/read-snapshot-store';
+
+// Exercise the production store with native IndexedDB/BroadcastChannel, independently of auth
+// routing or UI caches. A synthetic HTML harness avoids executing unrelated financial queries.
+const source = ts.transpileModule(
+  readFileSync(new URL('../apps/web/src/pwa/read-snapshot-store.ts', import.meta.url), 'utf8'),
+  { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } },
+).outputText;
+declare global {
+  interface Window {
+    snapshotStore: typeof Store;
+    pendingSnapshotToken: Store.SnapshotToken | undefined;
+    nativeSnapshotIDB: IDBFactory;
+    releaseSnapshotHold: () => void;
+  }
+}
+const stamp = Date.parse('2026-10-19T08:15:00Z');
+const params = 'month=2026-10&period=payday';
+const literal = { availableCents: 12345, bookedCents: -678, label: 'Synthetic view' };
+
+async function harness(page: Page) {
+  await page.route('**/__snapshot_security__', (route) =>
+    route.fulfill({
+      status: 200,
+      contentType: 'text/html',
+      body: '<!doctype html><title>Synthetic storage proof</title>',
+    }),
+  );
+  await page.goto('/__snapshot_security__');
+  await install(page);
+}
+async function install(page: Page) {
+  await page.evaluate(async (moduleSource) => {
+    const url = URL.createObjectURL(new Blob([moduleSource], { type: 'text/javascript' }));
+    try {
+      window.snapshotStore = await import(url);
+    } finally {
+      URL.revokeObjectURL(url);
+    }
+    await window.snapshotStore.initializeReadSnapshots();
+  }, source);
+}
+async function seed(page: Page) {
+  return page.evaluate(
+    async ({ params, literal, stamp }) => {
+      const store = window.snapshotStore;
+      // Simulate only the transport's verified-auth notification, not a persisted auth claim.
+      store.allowReadSnapshotWrites(store.readSnapshotGeneration());
+      const token = await store.beginReadSnapshot();
+      window.pendingSnapshotToken = token;
+      return store.saveReadSnapshot(token, {
+        view: 'today',
+        params,
+        fetchedAt: stamp,
+        data: literal,
+      });
+    },
+    { params, literal, stamp },
+  );
+}
+
+test('native snapshots preserve exact successful values/parameters across reload without auth metadata', async ({
+  page,
+}) => {
+  await harness(page);
+  expect(await seed(page)).toBe(true);
+  await page.reload();
+  await install(page);
+  const found = await page.evaluate(
+    async ({ params }) => ({
+      saved: await window.snapshotStore.loadReadSnapshot('today', params),
+      otherPeriod: await window.snapshotStore.loadReadSnapshot(
+        'today',
+        'month=2026-10&period=month',
+      ),
+      otherView: await window.snapshotStore.loadReadSnapshot('accounts', params),
+      token: await window.snapshotStore.beginReadSnapshot(),
+      local: { ...localStorage },
+    }),
+    { params },
+  );
+  expect(found.saved).toMatchObject({ view: 'today', params, fetchedAt: stamp, data: literal });
+  expect(Object.keys(found.saved ?? {}).sort()).toEqual([
+    'data',
+    'epoch',
+    'fetchedAt',
+    'params',
+    'view',
+  ]);
+  expect(found.otherPeriod).toBeUndefined();
+  expect(found.otherView).toBeUndefined();
+  expect(found.token).toBeUndefined(); // Reload does not revive authenticated write permission.
+  expect(found.local).toEqual({});
+});
+
+test('wipe rejects old responses, old status unlocks and optimistic background reads during logout', async ({
+  page,
+}) => {
+  await harness(page);
+  expect(await seed(page)).toBe(true);
+  const result = await page.evaluate(
+    async ({ params, literal, stamp }) => {
+      const store = window.snapshotStore;
+      const started = store.readSnapshotGeneration();
+      const pendingToken = store.beginReadSnapshot();
+      const release = store.holdReadSnapshotWrites();
+      const duringLogoutStatus = store.snapshotAuthorizationToken();
+      const cleared = store.clearReadSnapshots();
+      const hiddenSynchronously = store.readSnapshotGeneration() > started;
+      // An authenticated status request begun before sign-out cannot re-enable capture afterwards.
+      store.allowReadSnapshotWrites(started);
+      // Even a fresh status arriving before logout finishes cannot authorize captures.
+      store.allowReadSnapshotWrites(store.readSnapshotGeneration());
+      const whileLogoutPending = await store.beginReadSnapshot();
+      await cleared;
+      release();
+      store.allowReadSnapshotWrites(duringLogoutStatus);
+      return {
+        hiddenSynchronously,
+        pending: await pendingToken,
+        whileLogoutPending,
+        afterLateStatus: await store.beginReadSnapshot(),
+        oldSave: await store.saveReadSnapshot(window.pendingSnapshotToken, {
+          view: 'today',
+          params,
+          fetchedAt: stamp,
+          data: literal,
+        }),
+        saved: await store.loadReadSnapshot('today', params),
+        local: { ...localStorage },
+      };
+    },
+    { params, literal, stamp },
+  );
+  expect(result).toEqual({
+    hiddenSynchronously: true,
+    pending: undefined,
+    whileLogoutPending: undefined,
+    afterLateStatus: undefined,
+    oldSave: false,
+    saved: undefined,
+    local: {},
+  });
+  expect(await seed(page)).toBe(true); // A later verified session may capture a fresh response.
+});
+
+test('native cross-tab wipe hides copies and survives reload while unsent capture remains untouched', async ({
+  page,
+  context,
+}) => {
+  await harness(page);
+  expect(await seed(page)).toBe(true);
+  await page.evaluate(async () => {
+    await new Promise<void>((resolve, reject) => {
+      const open = indexedDB.open('budget-capture', 1);
+      open.onupgradeneeded = () => {
+        open.result.createObjectStore('bookings', { keyPath: 'id' });
+        open.result.createObjectStore('choices');
+      };
+      open.onerror = () => reject(open.error);
+      open.onsuccess = () => {
+        const db = open.result;
+        const tx = db.transaction('bookings', 'readwrite');
+        tx.objectStore('bookings').put({ id: 'synthetic-unsent', input: { amountCents: -123 } });
+        tx.oncomplete = () => {
+          db.close();
+          resolve();
+        };
+        tx.onerror = () => reject(tx.error);
+      };
+    });
+  });
+  const second = await context.newPage();
+  await harness(second);
+  expect(
+    await second.evaluate(
+      (params) => window.snapshotStore.loadReadSnapshot('today', params),
+      params,
+    ),
+  ).toBeTruthy();
+  const old = await page.evaluate(() => window.snapshotStore.readSnapshotRevision());
+  await second.evaluate(() => window.snapshotStore.clearReadSnapshots());
+  await expect
+    .poll(() => page.evaluate(() => window.snapshotStore.readSnapshotRevision()))
+    .toBeGreaterThan(old);
+  expect(
+    await page.evaluate((params) => window.snapshotStore.loadReadSnapshot('today', params), params),
+  ).toBeUndefined();
+  await page.reload();
+  await install(page);
+  expect(
+    await page.evaluate((params) => window.snapshotStore.loadReadSnapshot('today', params), params),
+  ).toBeUndefined();
+  expect(
+    await page.evaluate(
+      () =>
+        new Promise<unknown>((resolve, reject) => {
+          const open = indexedDB.open('budget-capture', 1);
+          open.onerror = () => reject(open.error);
+          open.onsuccess = () => {
+            const db = open.result;
+            const tx = db.transaction('bookings', 'readonly');
+            const read = tx.objectStore('bookings').get('synthetic-unsent');
+            tx.oncomplete = () => {
+              db.close();
+              resolve(read.result);
+            };
+            tx.onerror = () => reject(tx.error);
+          };
+        }),
+    ),
+  ).toEqual({ id: 'synthetic-unsent', input: { amountCents: -123 } });
+  await second.close();
+});
+
+test('failed erasure leaves a durable nonfinancial fence; reopening cannot revive old financial data', async ({
+  page,
+}) => {
+  await harness(page);
+  expect(await seed(page)).toBe(true);
+  await page.evaluate(async () => {
+    window.nativeSnapshotIDB = indexedDB;
+    Object.defineProperty(window, 'indexedDB', {
+      configurable: true,
+      value: {
+        open() {
+          throw new Error('synthetic blocked storage');
+        },
+      },
+    });
+    await window.snapshotStore.clearReadSnapshots();
+    Object.defineProperty(window, 'indexedDB', {
+      configurable: true,
+      value: window.nativeSnapshotIDB,
+    });
+  });
+  const marker = await page.evaluate(() => ({ ...localStorage }));
+  expect(Object.keys(marker)).toEqual(['budget-read-snapshot-epoch']);
+  expect(JSON.stringify(marker)).not.toContain('Synthetic');
+  expect(JSON.stringify(marker)).not.toContain('12345');
+  await page.reload();
+  await install(page);
+  expect(
+    await page.evaluate((params) => window.snapshotStore.loadReadSnapshot('today', params), params),
+  ).toBeUndefined();
+});
+
+test('a second tab and a cold reload cannot recapture while another tab is still logging out', async ({
+  page,
+  context,
+}) => {
+  await harness(page);
+  expect(await seed(page)).toBe(true);
+  await page.evaluate(async () => {
+    window.releaseSnapshotHold = window.snapshotStore.holdReadSnapshotWrites();
+    await window.snapshotStore.clearReadSnapshots();
+  });
+  const second = await context.newPage();
+  await harness(second);
+  const tryCapture = async () =>
+    second.evaluate(
+      async ({ params, literal, stamp }) => {
+        const store = window.snapshotStore;
+        const statusRequest = store.snapshotAuthorizationToken();
+        store.allowReadSnapshotWrites(statusRequest);
+        const token = await store.beginReadSnapshot();
+        return {
+          statusRequest,
+          token,
+          saved: await store.saveReadSnapshot(token, {
+            view: 'today',
+            params,
+            fetchedAt: stamp,
+            data: literal,
+          }),
+          loaded: await store.loadReadSnapshot('today', params),
+        };
+      },
+      { params, literal, stamp },
+    );
+  expect(await tryCapture()).toEqual({
+    statusRequest: undefined,
+    token: undefined,
+    saved: false,
+    loaded: undefined,
+  });
+  await second.reload();
+  await install(second);
+  expect(await tryCapture()).toEqual({
+    statusRequest: undefined,
+    token: undefined,
+    saved: false,
+    loaded: undefined,
+  });
+  await page.evaluate(async () => {
+    await window.snapshotStore.clearReadSnapshots();
+    window.releaseSnapshotHold();
+  });
+  await expect
+    .poll(() => second.evaluate(() => window.snapshotStore.snapshotAuthorizationToken()))
+    .not.toBeUndefined();
+  expect(await seed(second)).toBe(true);
+  await second.close();
+});
+
+test('a stale failed-wipe marker cannot rewind the database and authorize a pre-wipe response', async ({
+  page,
+}) => {
+  await harness(page);
+  expect(await seed(page)).toBe(true);
+  const old = await page.evaluate(() => window.pendingSnapshotToken!);
+  await page.evaluate(async (old) => {
+    await window.snapshotStore.clearReadSnapshots();
+    localStorage.setItem('budget-read-snapshot-epoch', old.epoch);
+  }, old);
+  await page.reload();
+  await install(page);
+  const result = await page.evaluate(
+    async ({ old, params, literal, stamp }) => {
+      const store = window.snapshotStore;
+      store.allowReadSnapshotWrites(store.snapshotAuthorizationToken());
+      return {
+        current: await store.beginReadSnapshot(),
+        stale: await store.saveReadSnapshot(old, {
+          view: 'today',
+          params,
+          fetchedAt: stamp,
+          data: literal,
+        }),
+        loaded: await store.loadReadSnapshot('today', params),
+      };
+    },
+    { old, params, literal, stamp },
+  );
+  expect(result.current?.epoch).not.toBe(old.epoch);
+  expect(result.stale).toBe(false);
+  expect(result.loaded).toBeUndefined();
+});
+
+test('read-only localStorage fails closed even while native IndexedDB remains accessible', async ({
+  page,
+}) => {
+  await harness(page);
+  expect(await seed(page)).toBe(true);
