+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { ApiError, onApiRead, request } from './http';
+import { recoveryLogin } from '../auth/api';
+import {
+  clearReadSnapshots,
+  readSnapshotGeneration,
+  snapshotAuthorizationToken,
+  setNetworkUnavailable,
+  setOfflineViewer,
+} from '../pwa/read-snapshot-store';
+
+const response = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), { status, headers: { 'content-type': 'application/json' } });
+const fetch = vi.fn<typeof globalThis.fetch>();
+const cleanup: (() => void)[] = [];
+
+beforeEach(() => {
+  localStorage.clear();
+  fetch.mockReset().mockImplementation(async () => response({ ok: true }));
+  vi.stubGlobal('fetch', fetch);
+  vi.spyOn(navigator, 'onLine', 'get').mockReturnValue(true);
+  setOfflineViewer(false);
+  setNetworkUnavailable(false);
+});
+afterEach(() => {
+  cleanup.splice(0).forEach((dispose) => dispose());
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe('offline read-only transport boundary (#558)', () => {
+  it('allows a real online recovery retry after a failed status GET, preserving the same-origin request', async () => {
+    fetch.mockRejectedValueOnce(new Error('synthetic disconnected status'));
+    await expect(request('GET', '/api/auth/status')).rejects.toMatchObject({
+      status: 0,
+      code: 'network',
+    });
+    await expect(recoveryLogin('synthetic-code')).resolves.toEqual({ ok: true });
+    expect(fetch).toHaveBeenLastCalledWith('/api/auth/recovery/login', {
+      method: 'POST',
+      credentials: 'same-origin',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ code: 'synthetic-code' }),
+    });
+  });
+
+  it('keeps online auth reconnect exceptions exact and excludes administration and saved/offline views', async () => {
+    for (const path of [
+      '/api/auth/login/options',
+      '/api/auth/login/verify',
+      '/api/auth/recovery/login',
+      '/api/auth/register/options',
+      '/api/auth/register/verify',
+      '/api/auth/step-up/options',
+      '/api/auth/step-up/verify',
+      '/api/auth/logout',
+    ]) {
+      setNetworkUnavailable(true);
+      await expect(request('POST', path, {})).resolves.toEqual({ ok: true });
+      expect(fetch).toHaveBeenLastCalledWith(path, expect.objectContaining({ method: 'POST' }));
+      setOfflineViewer(true);
+      await expect(request('POST', path, {})).rejects.toMatchObject({ code: 'offline_readonly' });
+      setOfflineViewer(false);
+      vi.spyOn(navigator, 'onLine', 'get').mockReturnValue(false);
+      await expect(request('POST', path, {})).rejects.toMatchObject({ code: 'offline_readonly' });
+      vi.spyOn(navigator, 'onLine', 'get').mockReturnValue(true);
+    }
+    const count = fetch.mock.calls.length;
+    setNetworkUnavailable(true);
+    for (const [method, path] of [
+      ['POST', '/api/auth/recovery/regenerate'],
+      ['POST', '/api/auth/sessions/revoke-others'],
+      ['DELETE', '/api/auth/passkeys/synthetic'],
+      ['POST', '/api/auth/logout/extra'],
+      ['DELETE', '/api/auth/logout'],
+    ] as const)
+      await expect(request(method, path, {})).rejects.toMatchObject({ code: 'offline_readonly' });
+    expect(fetch).toHaveBeenCalledTimes(count);
+  });
+
+  it.each(['POST', 'PUT', 'PATCH', 'DELETE'] as const)(
+    'denies offline %s before fetch, including idempotent queued capture',
+    async (method) => {
+      vi.spyOn(navigator, 'onLine', 'get').mockReturnValue(false);
+      await expect(
+        request(
+          method,
+          '/api/bookings',
+          { amountCents: -123 },
+          {
+            'Idempotency-Key': 'synthetic-queued-capture',
+          },
+        ),
+      ).rejects.toMatchObject({ status: 0, code: 'offline_readonly' });
+      expect(fetch).not.toHaveBeenCalled();
+    },
+  );
+
+  it('blocks writes after a lost connection even if navigator still reports online', async () => {
+    fetch.mockRejectedValueOnce(new Error('synthetic disconnection'));
+    await expect(request('GET', '/api/accounts')).rejects.toBeInstanceOf(ApiError);
+    await expect(request('PATCH', '/api/accounts/a', { name: 'Synthetic' })).rejects.toMatchObject({
+      status: 0,
+      code: 'offline_readonly',
+    });
+    expect(fetch).toHaveBeenCalledTimes(1);
+    // A real HTTP response re-establishes reachability; 503 is still returned to the caller.
+    fetch.mockResolvedValueOnce(response({ error: 'unavailable' }, 503));
+    await expect(request('GET', '/api/accounts')).rejects.toMatchObject({ status: 503 });
+    await expect(request('PATCH', '/api/accounts/a', { name: 'Synthetic' })).resolves.toEqual({
+      ok: true,
+    });
+  });
+
+  it('permits only the existing idempotent booking replay while online in the viewer', async () => {
+    setOfflineViewer(true);
+    for (const [method, path, headers] of [
+      ['POST', '/api/bookings', undefined],
+      ['POST', '/api/accounts', { 'Idempotency-Key': 'synthetic' }],
+      ['DELETE', '/api/bookings', { 'Idempotency-Key': 'synthetic' }],
+      ['POST', '/api/bookings', { 'Idempotency-Key': '' }],
+    ] as const) {
+      await expect(request(method, path, {}, headers)).rejects.toMatchObject({
+        code: 'offline_readonly',
+      });
+    }
+    expect(fetch).not.toHaveBeenCalled();
+    await request(
+      'POST',
+      '/api/bookings',
+      { amountCents: -123 },
+      { 'idempotency-key': 'synthetic' },
+    );
+    expect(fetch).toHaveBeenCalledExactlyOnceWith(
+      '/api/bookings',
+      expect.objectContaining({
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'content-type': 'application/json', 'idempotency-key': 'synthetic' },
+      }),
+    );
+  });
+
+  it('invalidates copies for denied authentication without treating a server error as offline data', async () => {
+    const reads = vi.fn();
+    cleanup.push(onApiRead(reads));
+    for (const status of [401, 403]) {
+      const generation = readSnapshotGeneration();
+      fetch.mockResolvedValueOnce(response({ error: 'synthetic_denial' }, status));
+      await expect(request('GET', '/api/accounts')).rejects.toMatchObject({ status });
+      expect(readSnapshotGeneration()).toBeGreaterThan(generation);
+    }
+    const generation = readSnapshotGeneration();
+    fetch.mockResolvedValueOnce(response({ error: 'unavailable' }, 503));
+    await expect(request('GET', '/api/accounts')).rejects.toMatchObject({ status: 503 });
+    expect(readSnapshotGeneration()).toBe(generation);
+    expect(reads).not.toHaveBeenCalled();
+  });
+
+  it('exposes only approved successful raw GETs, never auth material or optimistic write payloads', async () => {
+    const reads = vi.fn();
+    cleanup.push(onApiRead(reads));
+    fetch.mockResolvedValueOnce(
+      response({
+        setupRequired: false,
+        authenticated: true,
+        stepUpValidUntil: null,
+        viaRecovery: false,
+      }),
+    );
+    await request('GET', '/api/auth/status');
+    await request('GET', '/api/auth/passkeys');
+    await request('GET', '/api/reports/wealth');
+    await request('POST', '/api/bookings', { amountCents: -123 });
+    expect(reads).not.toHaveBeenCalled();
+    const literal = { accounts: [{ id: 'synthetic', balanceCents: 9876 }] };
+    fetch.mockResolvedValueOnce(response(literal));
+    const result = await request<typeof literal>('GET', '/api/accounts');
+    expect(result).toEqual(literal);
+    result.accounts[0]!.balanceCents = -999;
+    expect(reads).toHaveBeenCalledTimes(1);
+    expect(reads.mock.calls[0]?.[0]).toMatchObject({ path: '/api/accounts', data: literal });
+    expect(reads.mock.calls[0]?.[0]).not.toHaveProperty('headers');
+    cleanup.pop()?.();
+    await request('GET', '/api/accounts');
+    expect(reads).toHaveBeenCalledTimes(1);
+  });
+
+  it('invalidates on an actual unauthenticated response and synchronously on wipe intent', async () => {
+    const before = readSnapshotGeneration();
+    const erased = clearReadSnapshots();
+    expect(readSnapshotGeneration()).toBeGreaterThan(before);
+    await erased;
+    const generation = readSnapshotGeneration();
+    fetch.mockResolvedValueOnce(response({ setupRequired: false, authenticated: false }));
+    await request('GET', '/api/auth/status');
+    expect(readSnapshotGeneration()).toBeGreaterThan(generation);
+  });
+
+  it('does not clear an interrupted logout intent on authenticated status; a real new login clears it', async () => {
+    const marker = 'budget-read-snapshot-logout.synthetic-interrupted-intent';
+    localStorage.setItem(marker, '1');
+    fetch.mockResolvedValueOnce(response({ setupRequired: false, authenticated: true }));
+    await request('GET', '/api/auth/status');
+    expect(localStorage.getItem(marker)).toBe('1');
+    expect(snapshotAuthorizationToken()).toBeUndefined();
+    const generation = readSnapshotGeneration();
+    await request('POST', '/api/auth/login/verify', { id: 'synthetic-credential' });
+    expect(localStorage.getItem(marker)).toBeNull();
+    expect(readSnapshotGeneration()).toBeGreaterThan(generation);
+  });
+});
