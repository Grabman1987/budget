+export const savedExplorerEntryQuery = (id: string | undefined, entryKey: string) =>
+  queryOptions({
+    ...savedExplorerViewsQuery(),
+    queryKey: [...SAVED_EXPLORER_KEY, 'entry', id, entryKey],
