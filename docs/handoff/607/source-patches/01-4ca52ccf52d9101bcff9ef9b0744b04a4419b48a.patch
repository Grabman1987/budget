+type Snapshot = Record<string, unknown>;
+export interface ExpectedLifecycleEntry {
+  id: string;
+  entityType: string;
+  entityId: string;
+  action: string;
+  before: Snapshot | null;
+  after: Snapshot | null;
+  groupId: string | null;
+  undoOfId: string | null;
