+interface Entry extends ExpectedLifecycleEntry { sequence: number; ts: string }
+export interface PaymentPauseRange { fromDate: string; throughDate: string }
+export type PaymentDeletion = 'neverAssigned' | 'everAssigned' | 'unavailable';
+export interface PaymentLifecycle {
