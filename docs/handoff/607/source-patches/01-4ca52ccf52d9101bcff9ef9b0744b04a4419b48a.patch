+  const consumed = new Set<string>();
+  for (const [index, event] of events.entries()) {
+    if ([event.before, event.after].some((side) => side !== null && keys.some((key) => side[key] !== birth[key]))) return false;
+    if (index === 0) {
+      if (event.action !== 'create' || event.before !== null || event.undoOfId !== null) return false;
+    } else if (event.undoOfId !== null) {
+      const parent = seen.get(event.undoOfId);
+      if (event.action !== 'undo' || !parent || consumed.has(parent.id) ||
