+  const context: PaymentUndoContext = { parents: [], before: new Map(), maintenance: new Set(), today };
+  const candidates = selected.filter((e) => relationTypes.has(e.entityType));
+  if (!candidates.length) return context;
+  const roots = new Map(selected.map((e) => [e.id, rootOf(db, e)]));
+  const selectedRoots = new Map([...roots.values()].map((r) => [r.entry.id, r]));
+  const parentIds = new Set<string>();
+  const groups = new Map<string, Entry[]>();
+  for (const candidate of candidates) {
+    const root = roots.get(candidate.id)!.entry;
+    for (const id of parents(root)) parentIds.add(id);
+    let group: ExpectedLifecycleEntry[] = [root];
+    if (root.groupId) {
+      if (!groups.has(root.groupId)) {
+        const rows = db.all<Snapshot>(sql`SELECT ${auditColumns} FROM audit_log WHERE group_id=${root.groupId} ORDER BY rowid LIMIT ${LIMIT + 1}`);
+        if (rows.length > LIMIT) throw new AuditError('Die Zahlungsaktion ist zu umfangreich für eine sichere Rücknahme.');
+        groups.set(root.groupId, rows.map(parse));
+      }
+      group = groups.get(root.groupId)!;
+    }
+    const relevantParents = new Set(group.filter((e) => e.undoOfId === null && lifecycleRoot(e)).flatMap(parents));
+    const coupled = group.filter((e) => e.undoOfId === null && relationTypes.has(e.entityType) && parents(e).some((id) => relevantParents.has(id)));
+    if (parents(root).some((id) => relevantParents.has(id))) {
+      const depth = roots.get(candidate.id)!.depth;
+      if (coupled.some((e) => !selectedRoots.has(e.id) || selectedRoots.get(e.id)!.depth !== depth))
+        throw new AuditError('Pausieren, Beenden und zugehörige Termine bitte gemeinsam rückgängig machen.');
+      const chains = coupled.flatMap((e) => selectedRoots.get(e.id)!.chain);
+      const childCounts = db.all<{ parent: string; n: number }>(sql`SELECT undo_of_id AS parent, count(*) AS n FROM audit_log
+        WHERE undo_of_id IN (${placeholders(chains)}) GROUP BY undo_of_id`);
+      const tips = new Set(coupled.map((e) => selectedRoots.get(e.id)!.chain[0]!));
+      if (childCounts.some((row) => row.n > 1 || tips.has(row.parent)))
+        throw new AuditError('Diese Zahlungsaktion hat bereits eine andere Rückgängig-Folge. Bitte die aktuelle vollständige Aktion verwenden.');
+    }
+    if (root.entityType === 'expected_payment' && root.action === 'delete' && root.before?.deleted_at === null &&
+      root.after?.deleted_at != null && candidate.before?.deleted_at != null) {
+      try { assertPaymentDeletable(readPaymentLifecycles(db, [root.entityId]).get(root.entityId)); }
+      catch { throw new AuditError('Diese Zahlung hatte inzwischen eine Zuordnung. Löschen kann nicht wiederhergestellt werden; bitte „Beenden“ verwenden.'); }
+    }
+    if (candidate.entityType === 'expected_occurrence') {
+      context.before.set(candidate.entityId, db.get<Snapshot>(sql`SELECT * FROM expected_occurrence WHERE id=${candidate.entityId}`));
+      const bookingIds = [root.before?.booking_id, root.after?.booking_id].filter((id): id is string => typeof id === 'string');
+      const related = group.filter((e) => e.undoOfId === null && e.entityType === 'booking' && bookingIds.includes(e.entityId));
+      if (!group.some(lifecycleRoot) && related.length > 0 && related.every((e) => selectedRoots.has(e.id)))
+        context.maintenance.add(candidate.entityId);
+    }
+  }
+  context.parents = [...parentIds];
+  return context;
+}
+
+/** Called after physical replay and the existing expected-link coherence check. Failure rolls back. */
+export function assertPaymentLifecycleUndo(db: Executor, context: PaymentUndoContext): void {
+  if (!context.parents.length) return;
+  const facts = readPaymentLifecycles(db, context.parents);
+  for (const value of facts.values()) assertPaymentPauseRanges(value);
+  for (const [id, before] of context.before) {
+    if (context.maintenance.has(id) || openRaw(before)) continue;
+    const after = db.get<Snapshot>(sql`SELECT * FROM expected_occurrence WHERE id=${id}`);
+    if (!openRaw(after) || !after || typeof after.due_date !== 'string' || after.due_date < context.today) continue;
+    if (paymentDateSuppressed(facts.get(String(after.expected_payment_id)), after.due_date))
+      throw new AuditError('Dieser Termin ist pausiert oder beendet. Bitte zuerst die zugehörige Zahlungsaktion rückgängig machen.');
+  }
+}
