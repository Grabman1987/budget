+  const id = await page.evaluate(
+    async (data) =>
+      (
+        await window.receiptQueueStore.enqueueReceiptUpload(
+          new File([new Uint8Array(data)], 'synthetic-native-late.png', { type: '' }),
+        )
+      ).id,
+    [...PNG],
+  );
+  await installReceiptResponseFault(
+    page,
+    { id, target: null, filename: 'synthetic-native-late.png' },
+    '401',
+  );
+  expect(await page.evaluate(() => window.receiptQueueDelivery.sendReceiptQueue())).toEqual({
+    sent: 0,
+    blocked: 'login',
+  });
+  expect((await list(page))[0]).toMatchObject({
+    id,
+    uncertain: true,
+    failure: 'login',
+    bytes: [...PNG],
+  });
+  await page.evaluate(() => {
+    window.receiptTransportFault = '503';
+  });
+  expect(await page.evaluate(() => window.receiptQueueDelivery.sendReceiptQueue())).toEqual({
+    sent: 0,
+    blocked: 'server',
+  });
+  expect((await list(page))[0]).toMatchObject({
+    id,
+    uncertain: true,
+    failure: 'server',
+    bytes: [...PNG],
+  });
+  await page.evaluate(() => {
+    window.receiptTransportFault = 'hold';
+  });
+  const sending = page.evaluate(() => window.receiptQueueDelivery.sendReceiptQueue());
+  await expect.poll(() => page.evaluate(() => window.receiptTransportProof.held)).toBe(true);
+  const sibling = await context.newPage();
+  await harness(sibling);
+  await sibling.evaluate(async () => {
+    const hold = window.receiptQueueStore.holdReceiptQueueForSignOut();
+    await hold.clear();
+    await hold.release();
+  });
+  await page.evaluate(() => window.releaseReceiptReply());
+  expect(await sending).toEqual({ sent: 0, blocked: 'cleanup' });
+  await expect
+    .poll(async () => {
+      try {
+        return await list(page);
+      } catch {
+        return 'held';
+      }
+    })
+    .toEqual([]);
+  const proof = await page.evaluate(() => window.receiptTransportProof);
+  expect(proof.validated).toEqual([true, true, true]);
+  expect(proof.serverStatuses).toEqual([201, 201, 201]);
+  expect(proof.replies).toEqual(Array.from({ length: 3 }, () => proof.replies[0]));
+  expect(proof.seen).toEqual(
+    Array.from({ length: 3 }, () => ({ key: id, marker: id, target: null, bytes: [...PNG] })),
+  );
+});
