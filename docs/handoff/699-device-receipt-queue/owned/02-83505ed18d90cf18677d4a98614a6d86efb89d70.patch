+test('native cancel and send claims serialize across tabs; cancellation never removes an uncertain immutable intent', async ({
+  page,
+  context,
+}) => {
+  await harness(page);
+  const sibling = await context.newPage();
+  await harness(sibling);
+  const cancelled = await add(page);
+  expect(
+    await sibling.evaluate(
+      (id) => window.receiptQueueStore.cancelUnsentReceiptUpload(id),
+      cancelled.id,
+    ),
+  ).toBe(true);
+  expect(
+    await page.evaluate(
+      async (id) =>
+        window.receiptQueueStore.claimReceiptUpload(
+          await window.receiptQueueStore.beginReceiptQueue(),
+          id,
+        ),
+      cancelled.id,
+    ),
+  ).toBe(false);
+  const claimed = await add(page);
+  expect(
+    await page.evaluate(
+      async (id) =>
+        window.receiptQueueStore.claimReceiptUpload(
+          await window.receiptQueueStore.beginReceiptQueue(),
+          id,
+        ),
+      claimed.id,
+    ),
+  ).toBe(true);
+  await expect(
+    sibling.evaluate((id) => window.receiptQueueStore.cancelUnsentReceiptUpload(id), claimed.id),
+  ).rejects.toThrow('Serverempfang unklar');
+  expect((await list(page))[0]).toMatchObject({ id: claimed.id, uncertain: true, bytes });
+  const concurrent = await add(page, 'synthetic-race.pdf');
+  const [cancel, claim] = await Promise.allSettled([
+    sibling.evaluate((id) => window.receiptQueueStore.cancelUnsentReceiptUpload(id), concurrent.id),
+    page.evaluate(
+      async (id) =>
+        window.receiptQueueStore.claimReceiptUpload(
+          await window.receiptQueueStore.beginReceiptQueue(),
+          id,
+        ),
+      concurrent.id,
+    ),
+  ]);
+  const rows = await list(page);
+  if (cancel.status === 'fulfilled' && cancel.value) {
+    expect(claim).toMatchObject({ status: 'fulfilled', value: false });
+    expect(rows.some((row) => row.id === concurrent.id)).toBe(false);
+  } else {
+    expect(cancel.status).toBe('rejected');
+    expect(claim).toMatchObject({ status: 'fulfilled', value: true });
+    expect(rows.find((row) => row.id === concurrent.id)).toMatchObject({ uncertain: true, bytes });
+  }
+});
