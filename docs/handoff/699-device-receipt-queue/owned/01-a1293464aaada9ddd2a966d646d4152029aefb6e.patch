+    const freshToken = await store.beginReceiptQueue();
+    let oldClearRejected = false;
+    try {
+      await old.clear();
+    } catch {
+      oldClearRejected = true;
+    }
+    await old.release();
+    const freshTokenCurrent = store.receiptQueueTokenCurrent(freshToken);
+    const ids = (await store.listReceiptUploads()).map((item) => item.id);
+    window.dispatchEvent(
+      new StorageEvent('storage', {
+        key: 'budget-receipt-queue-epoch',
+        newValue: localStorage.getItem('budget-receipt-queue-epoch'),
+      }),
+    );
+    const sameEpochTokenCurrent = store.receiptQueueTokenCurrent(freshToken);
+    const newest = store.holdReceiptQueueForSignOut();
+    const newerHoldFenced = !store.receiptQueueTokenCurrent(freshToken);
+    await newest.clear();
+    await newest.release();
+    const newestToken = await store.beginReceiptQueue();
+    const afterNewWipe = await store.listReceiptUploads();
+    const pause = pauseNextNativeOpen();
+    const delayed = store.holdReceiptQueueForSignOut();
+    await pause.ready;
+    const delayedTicket = await store.prepareReceiptQueueRecovery();
+    await store.recoverReceiptQueueAfterConfirmedAction('new-recovery', delayedTicket);
+    const afterRecovery = await store.enqueueReceiptUpload(
+      new File(['synthetic preserved late-reservation bytes'], 'late-proof.pdf'),
+    );
+    pause.resume();
+    const lateReady = await delayed.ready;
+    let lateClearRejected = false;
+    try {
+      await delayed.clear();
+    } catch {
+      lateClearRejected = true;
+    }
+    await delayed.release();
+    const nativeCompletedId = await new Promise<string>((resolve, reject) => {
+      const request = indexedDB.open('budget-receipt-uploads', 1);
+      request.onerror = () => reject(request.error);
+      request.onsuccess = () => {
+        const db = request.result,
+          tx = db.transaction('meta', 'readonly'),
+          meta = tx.objectStore('meta');
+        const keys = meta.getAllKeys(),
+          values = meta.getAll();
+        tx.oncomplete = () => {
+          db.close();
+          const index = keys.result.findIndex(
+            (key, i) =>
+              typeof key === 'string' &&
+              key.startsWith('budget-receipt-queue-signout.') &&
+              values.result[i] === 'complete',
+          );
+          if (index < 0) reject(new Error('missing real completed native hold'));
+          else resolve(String(keys.result[index]));
+        };
+        tx.onabort = tx.onerror = () => {
+          db.close();
+          reject(new Error('native meta lookup failed'));
+        };
+      };
+    });
+    const retainedToken = await store.beginReceiptQueue();
+    const staleDelivered = new Promise<void>((resolve) => {
+      const unsubscribe = store.subscribeReceiptQueue(() => {
+        if (!store.receiptQueueTokenCurrent(retainedToken)) {
+          unsubscribe();
+          resolve();
+        }
+      });
+    });
+    const notifier = new BroadcastChannel('budget-receipt-uploads');
+    notifier.postMessage({ kind: 'hold', id: nativeCompletedId });
+    await staleDelivered;
+    notifier.close();
+    let staleKnownDenied = false;
+    try {
+      await store.listReceiptUploads();
+    } catch {
+      staleKnownDenied = true;
+    }
+    const repairTicket = await store.prepareReceiptQueueRecovery();
+    await store.recoverReceiptQueueAfterConfirmedAction('new-login', repairTicket);
+    const retainedAfterRepair = await store.listReceiptUploads(),
+      retainedEpoch = await store.beginReceiptQueue();
+    let reusedDenied = false,
+      absentDenied = false,
+      forgedDenied = false;
+    try {
+      await store.recoverReceiptQueueAfterConfirmedAction('new-login', repairTicket);
+    } catch {
+      reusedDenied = true;
+    }
+    try {
+      await Reflect.apply(store.recoverReceiptQueueAfterConfirmedAction, undefined, ['new-login']);
+    } catch {
+      absentDenied = true;
+    }
+    try {
+      await store.recoverReceiptQueueAfterConfirmedAction(
+        'new-login',
+        {} as Parameters<typeof store.recoverReceiptQueueAfterConfirmedAction>[1],
+      );
+    } catch {
+      forgedDenied = true;
+    }
+    return {
+      newerHeld,
+      laterNativeFallback:
+        laterReady.nativeFence === true && laterReady.localStorageFence === false,
+      empty,
+      oldClearRejected,
+      freshTokenCurrent,
+      freshId: fresh.id,
+      ids,
+      sameEpochTokenCurrent,
+      newerHoldFenced,
+      newerEpochFenced:
+        newestToken.epoch !== freshToken.epoch && !store.receiptQueueTokenCurrent(freshToken),
+      afterNewWipe,
+      lateReadyCancelled: lateReady.nativeFence === false,
+      lateClearRejected,
+      lateRetainedId: afterRecovery.id,
+      lateRetainedIds: retainedAfterRepair.map((item) => item.id),
+      staleKnownDenied,
+      repairedEpochUnchanged: retainedEpoch.epoch === retainedToken.epoch,
+      repairedLiteralBytes: await retainedAfterRepair[0]!.blob.text(),
+      reusedDenied,
+      absentDenied,
+      forgedDenied,
+      idsAfterRejectedTickets: (await store.listReceiptUploads()).map((item) => item.id),
+    };
+  });
+  expect(result).toEqual({
+    newerHeld: true,
+    laterNativeFallback: true,
+    empty: [],
+    oldClearRejected: true,
+    freshTokenCurrent: true,
+    freshId: result.freshId,
+    ids: [result.freshId],
+    sameEpochTokenCurrent: true,
+    newerHoldFenced: true,
+    newerEpochFenced: true,
+    afterNewWipe: [],
+    lateReadyCancelled: true,
+    lateClearRejected: true,
+    lateRetainedId: result.lateRetainedId,
+    lateRetainedIds: [result.lateRetainedId],
+    staleKnownDenied: true,
+    repairedEpochUnchanged: true,
+    repairedLiteralBytes: 'synthetic preserved late-reservation bytes',
+    reusedDenied: true,
+    absentDenied: true,
+    forgedDenied: true,
+    idsAfterRejectedTickets: [result.lateRetainedId],
+  });
+});
