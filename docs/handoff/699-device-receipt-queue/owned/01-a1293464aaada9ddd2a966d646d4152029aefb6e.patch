+      });
+    });
+    await askPeer('release');
+    await siblingReleased;
+    peer.close();
+    const empty = await store.listReceiptUploads();
+    const fresh = await store.enqueueReceiptUpload(
+      new File(['synthetic new selection'], 'fresh.pdf'),
