+            window.receiptQueueHold = window.receiptQueueStore.holdReceiptQueueForSignOut();
+            result = await window.receiptQueueHold.ready;
+          } finally {
+            Storage.prototype.setItem = original;
+          }
+          control.postMessage({ action: 'hold', result });
+        } else if (event.data.action === 'release') {
+          await window.receiptQueueHold.clear();
+          await window.receiptQueueHold.release();
+          control.postMessage({ action: 'release', result: {} });
+        }
+      } catch {
+        control.postMessage({ action: event.data.action, failed: true });
+      }
+    };
+  });
+  const result = await page.evaluate(async () => {
+    const store = window.receiptQueueStore;
+    const peer = new BroadcastChannel('synthetic-699-peer-control');
+    const askPeer = (action: 'hold' | 'release') =>
+      new Promise<{ nativeFence?: boolean; localStorageFence?: boolean }>((resolve, reject) => {
+        const receive = (
+          event: MessageEvent<{
+            action: string;
+            failed?: boolean;
+            result: { nativeFence?: boolean; localStorageFence?: boolean };
+          }>,
+        ) => {
+          if (event.data.action !== action) return;
+          peer.removeEventListener('message', receive);
+          if (event.data.failed) reject(new Error('synthetic sibling privacy action failed'));
+          else resolve(event.data.result);
+        };
+        peer.addEventListener('message', receive);
+        peer.postMessage({ action });
+      });
+    function pauseNextNativeOpen() {
+      const open = indexedDB.open.bind(indexedDB);
+      let release: (() => void) | undefined;
+      let captured!: () => void;
+      const ready = new Promise<void>((resolve) => {
+        captured = resolve;
+      });
+      indexedDB.open = function (...args) {
+        indexedDB.open = open;
+        const request = open(...args);
+        let success: ((this: IDBOpenDBRequest, event: Event) => unknown) | null = null;
+        Object.defineProperty(request, 'onsuccess', {
+          configurable: true,
+          set(handler) {
+            success = handler;
+          },
+        });
+        request.addEventListener('success', () => {
+          release = () => {
+            success?.call(request, new Event('success'));
+          };
+          captured();
+        });
+        return request;
+      };
+      return {
+        ready,
+        resume() {
+          if (!release) throw new Error('missing real native open callback');
+          release();
+        },
+      };
+    }
+    const old = store.holdReceiptQueueForSignOut();
+    await old.ready;
+    const ticket = await store.prepareReceiptQueueRecovery(); // BEFORE the confirmed ceremony request.
+    const gap = pauseNextNativeOpen();
+    const recovering = store.recoverReceiptQueueAfterConfirmedAction('new-login', ticket);
+    await gap.ready;
+    const laterReady = await askPeer('hold');
+    gap.resume();
+    await recovering;
+    let newerHeld = false;
+    try {
+      await store.listReceiptUploads();
+    } catch {
+      newerHeld = true;
+    }
+    const siblingReleased = new Promise<void>((resolve) => {
+      const unsubscribe = store.subscribeReceiptQueue(() => {
+        void store.listReceiptUploads().then(
+          () => {
+            unsubscribe();
+            resolve();
+          },
+          () => undefined,
