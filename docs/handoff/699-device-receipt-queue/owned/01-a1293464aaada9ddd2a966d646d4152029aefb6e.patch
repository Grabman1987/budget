+    const control = new BroadcastChannel('synthetic-699-peer-control');
+    control.onmessage = async (event: MessageEvent<{ action: string }>) => {
+      try {
+        if (event.data.action === 'hold') {
+          const original = Storage.prototype.setItem;
+          Storage.prototype.setItem = function () {
+            throw new DOMException(
+              'synthetic newer native-only sibling intent',
+              'QuotaExceededError',
