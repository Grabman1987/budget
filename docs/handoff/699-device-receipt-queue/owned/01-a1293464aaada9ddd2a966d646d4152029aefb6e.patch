+base(
+  'ephemeral native Blob capability yields either exact durable bytes or truthful not-saved with no queue row',
+  async ({ page }) => {
+    await harness(page);
+    const result = await page.evaluate(async (bytes) => {
+      const baseline = await new Promise<IDBDatabase>((resolve, reject) => {
+        const request = indexedDB.open('synthetic-699-ephemeral-capability', 1);
+        request.onupgradeneeded = () => request.result.createObjectStore('values');
+        request.onsuccess = () => resolve(request.result);
+        request.onerror = () => reject(request.error);
+      });
+      let nativeError: string | undefined;
+      let nativeSupported: boolean;
+      let baselineBytes: number[] = [];
+      try {
+        nativeSupported = await new Promise<boolean>((resolve) => {
+          const tx = baseline.transaction('values', 'readwrite');
+          tx.oncomplete = () => resolve(true);
+          tx.onabort = () => {
+            nativeError ??= tx.error?.name ?? 'AbortError';
+            resolve(false);
+          };
+          try {
+            const request = tx
+              .objectStore('values')
+              .put(new Blob([new Uint8Array(bytes)], { type: '' }), 'synthetic-blob');
+            request.onerror = () => {
+              nativeError = request.error?.name ?? 'UnknownError';
+            };
+          } catch (error) {
+            nativeError = error instanceof Error ? error.name : 'UnknownError';
+            tx.abort();
+          }
+        });
+        if (nativeSupported) {
+          const blob = await new Promise<Blob>((resolve, reject) => {
+            const tx = baseline.transaction('values', 'readonly');
+            const request = tx.objectStore('values').get('synthetic-blob');
+            tx.oncomplete = () => resolve(request.result as Blob);
+            tx.onabort = () => reject(tx.error);
+          });
+          baselineBytes = [...new Uint8Array(await blob.arrayBuffer())];
+        }
+      } finally {
+        baseline.close();
+      }
+      const store = window.receiptQueueStore;
+      let savedKey: string | undefined;
+      let errorMessage: string | undefined;
+      try {
+        savedKey = (
+          await store.enqueueReceiptUpload(
+            new File([new Uint8Array(bytes)], 'synthetic-ephemeral.pdf', { type: '' }),
+          )
+        ).id;
+      } catch (error) {
+        errorMessage = error instanceof Error ? error.message : 'UnknownError';
+      }
+      const rows = await store.listReceiptUploads();
+      return {
+        nativeSupported,
+        nativeError,
+        baselineBytes,
+        savedKey,
+        errorMessage,
+        keys: rows.map((row) => row.id),
+        storedBytes: rows[0] ? [...new Uint8Array(await rows[0].blob.arrayBuffer())] : [],
+      };
+    }, bytes);
+    if (result.nativeSupported) {
+      expect(result.nativeError).toBeUndefined();
+      expect(result.baselineBytes).toEqual(bytes);
+      expect(result.errorMessage).toBeUndefined();
+      expect(result.savedKey).toEqual(expect.any(String));
+      expect(result.keys).toEqual([result.savedKey]);
+      expect(result.storedBytes).toEqual(bytes);
+    } else {
+      expect(result.nativeError).toEqual(expect.any(String));
+      expect(result.savedKey).toBeUndefined();
+      expect(result.errorMessage).toBe(
+        'Beleg nicht auf dem Gerät gespeichert. Lass die Dateiauswahl geöffnet und versuch es erneut.',
+      );
+      expect(result.keys).toEqual([]);
+      expect(result.storedBytes).toEqual([]);
+    }
+  },
