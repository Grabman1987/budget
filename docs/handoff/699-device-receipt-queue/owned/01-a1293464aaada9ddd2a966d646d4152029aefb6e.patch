+test('a late second ceremony ticket cannot erase fresh bytes and recovery validation shares the native wipe transaction', async ({
+  page,
+}) => {
+  await harness(page);
+  await add(page);
+  const result = await page.evaluate(async () => {
+    const store = window.receiptQueueStore;
+    const old = store.holdReceiptQueueForSignOut();
+    await old.ready;
+    const delayedTicket = await store.prepareReceiptQueueRecovery();
+    const winningTicket = await store.prepareReceiptQueueRecovery();
+    await store.recoverReceiptQueueAfterConfirmedAction('new-login', winningTicket);
+    const fresh = await store.enqueueReceiptUpload(
+      new File(['literal fresh bytes after winning ceremony'], 'kept-after-login.pdf'),
+      'synthetic-saved-booking',
+    );
+    const freshEpoch = (await store.beginReceiptQueue()).epoch;
+    let staleDenied = false;
+    try {
+      await store.recoverReceiptQueueAfterConfirmedAction('new-login', delayedTicket);
+    } catch {
+      staleDenied = true;
+    }
+    const retained = await store.listReceiptUploads();
+    const retainedEpoch = (await store.beginReceiptQueue()).epoch;
+    const retainedBytes = await retained[0]!.blob.text();
+    const secondOld = store.holdReceiptQueueForSignOut();
+    await secondOld.ready;
+    const capturedId = Object.keys(localStorage).find((key) =>
+      key.startsWith('budget-receipt-queue-signout.'),
+    );
+    if (!capturedId) throw new Error('missing synthetic hold');
+    const firstTicket = await store.prepareReceiptQueueRecovery();
+    const competingTicket = await store.prepareReceiptQueueRecovery();
+    const get = IDBObjectStore.prototype.get;
+    const clear = IDBObjectStore.prototype.clear;
+    const reads = new Map<IDBTransaction, Set<IDBValidKey | IDBKeyRange>>();
+    let atomicValidation = false;
+    let wipes = 0;
+    let competing: Promise<void> | undefined;
+    IDBObjectStore.prototype.get = function (key) {
+      if (this.name === 'meta' && this.transaction.mode === 'readwrite') {
+        const keys = reads.get(this.transaction) ?? new Set<IDBValidKey | IDBKeyRange>();
+        keys.add(key);
+        reads.set(this.transaction, keys);
+      }
+      return get.call(this, key);
+    };
+    IDBObjectStore.prototype.clear = function () {
+      if (this.name === 'intents') {
+        wipes++;
+        const keys = reads.get(this.transaction);
+        atomicValidation = keys?.has('epoch') === true && keys.has(capturedId);
+        // A second real recovery starts before the first native wipe transaction commits.
+        competing = store.recoverReceiptQueueAfterConfirmedAction('new-recovery', competingTicket);
+        void competing.catch(() => undefined);
+      }
+      return clear.call(this);
+    };
+    let competingDenied = false;
+    try {
+      await store.recoverReceiptQueueAfterConfirmedAction('new-login', firstTicket);
+      if (!competing) throw new Error('missing interleaved synthetic ceremony');
+      try {
+        await competing;
+      } catch {
+        competingDenied = true;
+      }
+    } finally {
+      IDBObjectStore.prototype.get = get;
+      IDBObjectStore.prototype.clear = clear;
+    }
+    const afterConcurrent = await store.enqueueReceiptUpload(
+      new File(['literal bytes after interleaved ceremonies'], 'kept-after-race.pdf'),
+    );
+    const final = await store.listReceiptUploads();
+    return {
+      staleDenied,
+      originalKey: fresh.id,
+      retainedKeys: retained.map((item) => item.id),
+      retainedBytes,
+      retainedFilename: retained[0]!.filename,
+      retainedTarget: retained[0]!.bookingId,
+      epochUnchanged: freshEpoch === retainedEpoch,
+      atomicValidation,
+      wipes,
+      competingDenied,
+      finalKey: afterConcurrent.id,
+      finalKeys: final.map((item) => item.id),
+      finalBytes: await final[0]!.blob.text(),
+    };
+  });
+  expect(result).toEqual({
+    staleDenied: true,
+    originalKey: result.originalKey,
+    retainedKeys: [result.originalKey],
+    retainedBytes: 'literal fresh bytes after winning ceremony',
+    retainedFilename: 'kept-after-login.pdf',
+    retainedTarget: 'synthetic-saved-booking',
+    epochUnchanged: true,
+    atomicValidation: true,
+    wipes: 1,
+    competingDenied: true,
+    finalKey: result.finalKey,
+    finalKeys: [result.finalKey],
+    finalBytes: 'literal bytes after interleaved ceremonies',
+  });
+});
