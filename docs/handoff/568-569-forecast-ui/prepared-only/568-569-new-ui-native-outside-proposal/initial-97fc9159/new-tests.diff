+
+test.use({ ledgerToday: '2026-09-17' });
+const TODAY = '2026-09-17';
+interface Seed { accountId: string; debitId: string }
+async function seed(request: APIRequestContext, origin: string): Promise<Seed> {
+  async function post<T>(path: string, data: unknown): Promise<T> {
+    const response = await request.post(`${origin}/api${path}`, { headers: { origin }, data });
+    expect(response.ok(), await response.text()).toBe(true);
+    return response.json() as Promise<T>;
+  }
+  const { account } = await post<{ account: { id: string } }>('/accounts', { name: 'Synthetic forecast account', type: 'checking', openingDate: TODAY, openingBalanceCents: 100000 });
+  const { payment } = await post<{ payment: { id: string } }>('/expected', { name: 'Synthetic debit', kind: 'outflow', accountId: account.id, rhythm: 'monthly', dueDay: 27, startDate: '2026-09-27', endDate: '2026-09-27', validFrom: TODAY, dateShift: 'none', amountCents: 30000 });
+  await post('/expected', { name: 'Synthetic salary', kind: 'inflow', accountId: account.id, incomeTypeId: 'income-salary', rhythm: 'monthly', dueDay: 7, startDate: '2026-10-07', endDate: '2026-10-07', validFrom: TODAY, dateShift: 'none', amountCents: 9000 });
+  return { accountId: account.id, debitId: payment.id };
+}
+async function hit(target: Locator, minimum: number) {
+  await target.scrollIntoViewIfNeeded();
+  await expect(target).toBeVisible();
+  const r = await target.evaluate((element) => {
+    const b = element.getBoundingClientRect();
+    const owner = document.elementFromPoint(b.left + b.width / 2, b.top + b.height / 2);
+    return { left: b.left, right: b.right, top: b.top, bottom: b.bottom, width: b.width, height: b.height, viewportWidth: innerWidth, viewportHeight: innerHeight, owned: owner === element || (owner !== null && element.contains(owner)) };
+  });
+  expect(r.width).toBeGreaterThanOrEqual(minimum); expect(r.height).toBeGreaterThanOrEqual(minimum);
+  expect(r.left).toBeGreaterThanOrEqual(0); expect(r.right).toBeLessThanOrEqual(r.viewportWidth);
+  expect(r.top).toBeGreaterThanOrEqual(0); expect(r.bottom).toBeLessThanOrEqual(r.viewportHeight);
+  expect(r.owned).toBe(true);
+}
+async function chartGeometry(chart: Locator) {
+  await expect(chart.getByTestId('liquidity-mark-heute')).toHaveText('HEUTE');
+  // Small real salary9000 must not be suppressed by the25000c large-movement table cutoff.
+  await expect(chart.getByTestId('liquidity-mark-gehalt')).toHaveText('GEHALT 07.10.');
+  await expect(chart.getByTestId('liquidity-lowpoint')).toHaveAttribute('data-day', '2026-09-27');
+  await expect(chart.getByTestId('liquidity-lowpoint')).toHaveAttribute('data-cents', '70000');
+  const geometry = await chart.evaluate((element) => {
+    const rect = (node: Element) => { const r = node.getBoundingClientRect(); return { left: r.left, right: r.right, top: r.top, bottom: r.bottom, width: r.width, height: r.height }; };
+    const svg = element.querySelector('svg[data-testid="liquidity-chart"]')!;
+    const low = element.querySelector('[data-testid="liquidity-lowpoint"]')!;
+    return { svg: rect(svg), texts: [...low.querySelectorAll('text')].map(rect), dot: rect(low.querySelector('circle')!), markers: [...element.querySelectorAll('[data-testid="liquidity-mark-heute"], [data-testid="liquidity-mark-gehalt"]')].map(rect), forecast: rect(element.querySelector('.l-forecast')!) };
+  });
+  expect(geometry.texts).toHaveLength(2); expect(geometry.markers).toHaveLength(2);
+  for (const text of [...geometry.texts, ...geometry.markers]) {
+    expect(text.width).toBeGreaterThan(0); expect(text.height).toBeGreaterThan(0);
+    expect(text.left).toBeGreaterThanOrEqual(geometry.svg.left); expect(text.right).toBeLessThanOrEqual(geometry.svg.right);
+    expect(text.top).toBeGreaterThanOrEqual(geometry.svg.top); expect(text.bottom).toBeLessThanOrEqual(geometry.svg.bottom);
+  }
+  expect(geometry.texts[0]!.top).toBeGreaterThanOrEqual(geometry.dot.bottom);
+  expect(geometry.texts[0]!.top).toBeGreaterThanOrEqual(geometry.forecast.bottom);
+  expect(geometry.texts[1]!.top).toBeGreaterThanOrEqual(geometry.texts[0]!.bottom);
+  for (const marker of geometry.markers) expect(marker.bottom).toBeLessThanOrEqual(geometry.forecast.top);
+  const [today, salary] = geometry.markers;
+  expect(today!.right <= salary!.left || salary!.right <= today!.left || today!.bottom <= salary!.top || salary!.bottom <= today!.top).toBe(true);
+  return geometry;
+}
