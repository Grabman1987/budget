+/** Stand-today forecast: exactly the same read and unmodified series as the linked detail. */
+function CompactForecastCard() {
+  useAmountPrivacy();
+  const forecast = useQuery(liquidityQuery('35d', []));
+  const payments = useQuery(expectedQuery());
+  const view = forecast.isSuccess ? forecast.data : undefined;
+  const report = !forecast.isFetching && !forecast.isError ? view?.report : undefined;
+  const salaryIds = new Set(
+    (payments.data ?? []).filter((payment) => payment.incomeTypeId === 'income-salary').map((payment) => payment.id),
+  );
+  return (
+    <section className="heute-section heute-compact-forecast" aria-labelledby="heute-forecast-title">
+      <div className="heute-compact-forecast-head">
+        <h2 id="heute-forecast-title">Kontoprognose · 35 Tage</h2>
+        <AppLink
+          className="btn btn-ghost"
+          to="/plan/prognose"
+          search={{ horizon: '35d', levers: '' }}
+          aria-label="Details zur Kontoprognose für 35 Tage"
+        >
+          Details
+        </AppLink>
+      </div>
+      {forecast.isFetching && <LoadingNote what="Kontoprognose" />}
+      {forecast.isError && <ErrorNote what="Kontoprognose" error={forecast.error} onRetry={() => void forecast.refetch()} />}
+      {view && !view.available && <EmptyNote>Ohne Budget-Konto gibt es keine Kontoprognose.</EmptyNote>}
+      {report && (
+        <>
+          <p className="heute-note">Stand heute · {longDay(view?.asOf ?? report.startDay)} · ohne Stellschrauben</p>
+          <LiquidityChart report={report} salaryDay={salaryDay(report, salaryIds)} compact />
+          <p className="heute-forecast-low" data-day={report.low?.day} data-cents={report.low?.cents}>
+            {report.low
+              ? <>Tiefpunkt: <strong>{eur(report.low.cents)}</strong>{' · '}am {longDay(report.low.day)}</>
+              : 'Kein Tiefpunkt verfügbar.'}
+          </p>
+        </>
+      )}
+    </section>
+  );
+}
