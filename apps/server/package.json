{
  "name": "@budget/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/index.ts src/imports/import-worker.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --outdir=dist --entry-names=[name] --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@budget/db": "*",
    "@budget/domain": "*",
    "@budget/market": "*",
    "@budget/import-ynab": "*",
    "@hono/node-server": "^1.19.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@budget/fixtures": "*",
    "esbuild": "^0.25.0"
  }
}
